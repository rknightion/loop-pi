{
  "defaultProjectTrust": "never",
  "enableInstallTelemetry": false,
  "enabledModels": [
    "openai/gpt-6.1-sol",
    "openai/gpt-6-luna",
    "openai/gpt-6-astra"
  ],
  "httpIdleTimeoutMs": 300000,
  "tuiMode": "regular",
  "retry": {
    "maxRetries": 60,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 60000,
    "provider": {
      "maxRetries": 0
    }
  },
  "extensions": [
    "-builtin:mcp",
    "-builtin:llama.cpp",
    "-builtin:codemode",
    "-builtin:tool-search"
  ],
  "packages": [
    "{{PREFIX}}/node_modules/pi-subagents"
  ],
  "subagents": {
    "disableBuiltins": true
  },
  "compaction": {
    "reserveTokens": 70000
  },
  "loopPi": {
    "onIncident": []
  }
}
