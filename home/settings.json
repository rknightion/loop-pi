{
  "defaultProjectTrust": "never",
  "enableInstallTelemetry": false,
  "enabledModels": [
    "openai/gpt-6-*"
  ],
  "httpIdleTimeoutMs": 300000,
  "retry": {
    "maxRetries": 60,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 60000,
    "provider": {
      "maxRetries": 0
    }
  },
  "packages": [
    "{{PREFIX}}/node_modules/pi-subagents"
  ],
  "subagents": {
    "disableBuiltins": true
  },
  "compaction": {
    "reserveTokens": 70000
  }
}
