{
  "defaultProjectTrust": "never",
  "enableInstallTelemetry": false,
  "enabledModels": [
    "openai/gpt-6.2-sol",
    "openai/gpt-6.1-terra",
    "openai/gpt-6.2-astra"
  ],
  "httpIdleTimeoutMs": 300000,
  "tuiMode": "regular",
  "retry": {
    "maxRetries": 16,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 60000,
    "provider": {
      "maxRetries": 0
    }
  },
  "extensions": [
    "-builtin:mcp",
    "-builtin:llama.cpp",
    "-builtin:tool-search"
  ],
  "defaultTools": ["+codemode"],
  "packages": [
    { "source": "{{PREFIX}}/node_modules/pi-subagents", "skills": [] }
  ],
  "subagents": {
    "disableBuiltins": true
  },
  "compaction": {
    "reserveTokens": 70000
  },
  "loopPi": {
    "onIncident": []
  }
}
