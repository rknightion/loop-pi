#!/usr/bin/env python3
"""Build, validate and install the pinned loop-pi runtime, one pi home and its launcher.

A build is staged into an absent directory, validated (pins, `pi --version`, agent set, model
family, required hook scripts, an RPC smoke load of the root and lane entries), then renamed into
`<data>/<label>`, where the label is the pinned pi version plus a hash of everything copied in.
Existing builds are kept for rollback. The home is then updated file by file from the build's
rendered templates; `auth.json`, sessions and every other unmanaged file are never touched.
`--check` reports drift and writes nothing.

An optional overlay directory customises a build without editing the source:
  overlay/home/**           replaces or adds home template files (home/lane-policy.md included)
  overlay/home/settings.json  is deep-merged over home/settings.json (the overlay wins)
  overlay/policy.md         is appended to the rendered AGENTS.md after home/policy-header.md
  overlay/scripts/*         land in <home>/scripts/ (guard and hook scripts)
Templates render {{HOME}}, {{PREFIX}}, {{USER_HOME}} and every `--var KEY=VALUE`.

The installed home's `lane-policy.md` is appended, after a `<!-- lane-policy -->` marker line, to
the body of every agent file whose frontmatter says `inheritGlobalContext: false`. When the build
carries `bin/loop-state` it is installed into `<home>/bin/`. `--variant NAME` is recorded in the
home receipt so each session can name the variant it ran with.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Dict, List, Optional, Tuple

SRC = Path(__file__).resolve().parents[1]
USER_HOME = Path.home()
# pi writes these into settings.json itself; the installer keeps them rather than reporting drift.
PI_RUNTIME_SETTINGS = ("lastChangelogVersion", "theme")
DEFAULT_DATA = USER_HOME / ".local/share/loop-pi"
DEFAULT_BIN = USER_HOME / ".local/bin"
PI_PACKAGE = "@earendil-works/pi-coding-agent"
SUBAGENTS_PACKAGE = "pi-subagents"
PI_CLI = f"node_modules/{PI_PACKAGE}/dist/bundle/cli.js"
BUILD_MANIFEST = ".loop-pi-build.json"
HOME_MANIFEST = ".loop-pi-managed.json"
# Root-only extensions, loaded by launcher flags, never by settings packages.
ROOT_EXTENSIONS = ("loop-guard/root.ts", "loop-wait/root.ts", "loop-continuation/index.ts", "loop-state/index.ts",
                   "lane-worktrees/index.ts", "call-timing/index.ts")
# The dispatcher host loads only its own entry: it registers the lane children itself and answers
# pi-subagents' completion turns with an in-process idle model (extensions/dispatcher).
DISPATCH_EXTENSIONS = ("dispatcher/index.ts",)
# Lane entries, registered by the root guard as required child extensions.
LANE_EXTENSIONS = ("loop-guard/lane.ts", "loop-wait/lane.ts", "call-timing/index.ts")
# Operator and root CLIs from bin/, installed next to the launcher.
CLI_TOOLS = ("loop-pi-preflight", "loop-pi-audit", "loop-gate-lock")
# Installed into <home>/bin/ (not next to the launcher) when the source carries it.
HOME_TOOLS = ("loop-state",)
LANE_POLICY = "lane-policy.md"
LANE_POLICY_MARKER = "<!-- lane-policy -->"
NEVER_MANAGED = {"auth.json"}
MIN_NODE = (22, 19, 0)
# Fixed discovery order, independent of the installing shell (Homebrew first).
NODE_CANDIDATES = ("/opt/homebrew/bin/node", "/usr/local/bin/node", "/usr/bin/node")
AGENT_SET = {"mapper", "mapper-deep", "gate-runner", "lane-worker", "lane-worker-push", "lane-worker-low",
             "lane-worker-low-push", "lane-worker-retry", "lane-worker-retry-push", "complex-worker",
             "complex-worker-push", "super-worker", "super-worker-push", "megasuper-worker",
             "megasuper-worker-push", "reviewer", "reviewer-high", "security-reviewer", "rescue-sol",
             "rescue-astra", "ops", "ops-probe", "triager"}
SMOKE_COMMAND = "loop-closeout"
# Defaults for settings.json `loopPi`; the extensions use the same ones (model-family.ts).
DEFAULT_FAMILY = {"provider": "openai", "pattern": r"^gpt-6(\.[0-9]+)?(-[a-z0-9]+)+$", "name": "gpt-6"}
DEFAULT_ROOT_ROUTE = {"provider": "openai", "model": "gpt-6.1-sol", "thinking": "low"}
EXCLUDED_PARTS = {"node_modules", "__tests__", "test-support", "fixtures"}


class InstallError(Exception):
    pass


def pins(src: Path = SRC) -> Dict[str, str]:
    deps = json.loads((src / "package.json").read_text())["dependencies"]
    for name in (PI_PACKAGE, SUBAGENTS_PACKAGE):
        version = deps.get(name, "")
        if not version or not version[0].isdigit():
            raise InstallError(f"{name} must be pinned to an exact version, found {version!r}")
    return {PI_PACKAGE: deps[PI_PACKAGE], SUBAGENTS_PACKAGE: deps[SUBAGENTS_PACKAGE]}


def _tree(base: Path, prefix: str) -> List[Tuple[str, Path]]:
    files = []
    if not base.is_dir():
        return files
    for path in sorted(base.rglob("*")):
        rel = path.relative_to(base)
        if path.is_dir() or EXCLUDED_PARTS & set(rel.parts):
            continue
        if (path.name.endswith((".test.ts", ".test.mjs", "test-helpers.ts")) or path.name.startswith("test-")
                or path.name == ".DS_Store" or "__pycache__" in rel.parts):
            continue
        files.append((f"{prefix}/{rel.as_posix()}", path))
    return files


def source_files(src: Path = SRC, overlay: Optional[Path] = None) -> List[Tuple[str, Path]]:
    """Every file copied into a build, as (build-relative path, source path). Overlay files that
    replace a template come after it, so a copy in order leaves the overlay's bytes."""
    files = [("package.json", src / "package.json"), ("package-lock.json", src / "package-lock.json")]
    files += _tree(src / "extensions", "extensions") + _tree(src / "home", "home")
    files += [(f"bin/{name}", src / "bin" / name) for name in CLI_TOOLS]
    files += [(f"bin/{name}", src / "bin" / name) for name in HOME_TOOLS if (src / "bin" / name).is_file()]
    if overlay is not None:
        if not overlay.is_dir():
            raise InstallError(f"overlay {overlay} is not a directory")
        files += [(rel, path) for rel, path in _tree(overlay / "home", "home") if rel != "home/settings.json"]
        files += _tree(overlay / "scripts", "home/scripts")
        for name in ("home/settings.json", "policy.md"):
            if (overlay / name).is_file():
                files.append((f"overlay/{name}", overlay / name))
    return files


def deep_merge(base: dict, over: dict) -> dict:
    merged = dict(base)
    for key, value in over.items():
        if isinstance(value, dict) and isinstance(merged.get(key), dict):
            merged[key] = deep_merge(merged[key], value)
        else:
            merged[key] = value
    return merged


def settings_template(staging: Path) -> dict:
    return json.loads((staging / "home/settings.json").read_text())


def apply_overlay_settings(staging: Path) -> None:
    extra = staging / "overlay/home/settings.json"
    if extra.is_file():
        merged = deep_merge(settings_template(staging), json.loads(extra.read_text()))
        (staging / "home/settings.json").write_text(json.dumps(merged, indent=2) + "\n")


def render_policy(staging: Path, policy_source: str) -> None:
    """Write home/AGENTS.md from home/policy-header.md and the overlay's policy.md."""
    header = staging / "home/policy-header.md"
    policy = staging / "overlay/policy.md"
    body = [f"<!-- GENERATED FILE: edit {policy_source}, not this file. -->\n",
            header.read_text() if header.is_file() else "",
            policy.read_text() if policy.is_file() else ""]
    (staging / "home/AGENTS.md").write_text("".join(body))
    header.unlink(missing_ok=True)


def build_label(files: List[Tuple[str, Path]], pin: Dict[str, str], extra: str = "") -> str:
    digest = hashlib.sha256()
    for rel, path in files:
        digest.update(rel.encode() + b"\0" + path.read_bytes() + b"\0")
    if extra:
        digest.update(extra.encode() + b"\0")
    return f"{pin[PI_PACKAGE]}-{digest.hexdigest()[:10]}"


def node_version(node: str) -> str:
    try:
        result = subprocess.run([node, "--version"], capture_output=True, text=True,
                                check=True, timeout=15)
    except (OSError, subprocess.SubprocessError) as error:
        raise InstallError(f"cannot run node {node}: {error}") from error
    raw = result.stdout.strip()
    match = re.fullmatch(r"v([0-9]+)\.([0-9]+)\.([0-9]+)", raw)
    if not match:
        raise InstallError(f"node {node} returned an invalid version: {raw!r}")
    if tuple(map(int, match.groups())) < MIN_NODE:
        raise InstallError(f"node {raw} is older than {'.'.join(map(str, MIN_NODE))}")
    return raw


def node_binary(explicit: Optional[str] = None, home: Optional[Path] = None) -> str:
    """CLI/env override, then the home's receipt, then fixed absolute candidates.

    Missing or broken recorded nodes are errors, never an implicit runtime switch, except a
    vanished Homebrew Cellar node whose keg link runs the same major version.
    Legacy receipts without node metadata migrate on the next installation.
    """
    node = explicit or os.environ.get("LOOP_PI_NODE")
    if not node and home is not None and (home / HOME_MANIFEST).is_file():
        try:
            record = json.loads((home / HOME_MANIFEST).read_text())
            if not isinstance(record, dict):
                raise ValueError("receipt must be an object")
            if "node" in record:
                node = record["node"]["path"]
                if not isinstance(node, str) or not node:
                    raise ValueError("invalid node path")
                if not Path(node).exists():
                    node = same_major_keg_link(node, record["node"].get("version"))
        except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
            raise InstallError(f"invalid node receipt in {home / HOME_MANIFEST}") from error
    if not node:
        node = next((path for path in NODE_CANDIDATES if Path(path).is_file()), None)
    if not node:
        raise InstallError("node not found in fixed locations; supply --node or LOOP_PI_NODE")
    path = Path(node).expanduser()
    if not path.is_absolute():
        raise InstallError("node must be an absolute path")
    node = stable_node(path)
    node_version(node)
    return node


# A Homebrew node resolves into <prefix>/Cellar/<formula>/<version>/bin/node, which a revision
# upgrade plus cleanup deletes. Record the keg's <prefix>/opt/<formula> link instead: it is just as
# PATH-independent and survives revision upgrades.
CELLAR_NODE = re.compile(r"(?P<prefix>/.+)/Cellar/(?P<formula>[^/]+)/[^/]+/bin/node")


def keg_link(cellar_path: str) -> Optional[Path]:
    match = CELLAR_NODE.fullmatch(cellar_path)
    if not match:
        return None
    return Path(match["prefix"]) / "opt" / match["formula"] / "bin" / "node"


def stable_node(path: Path) -> str:
    resolved = path.resolve()
    link = keg_link(str(resolved))
    if link is not None and link.is_file() and link.resolve() == resolved:
        return str(link)
    return str(resolved)


def same_major_keg_link(missing: str, recorded_version: object) -> str:
    """A recorded Cellar node that no longer exists migrates to its keg link only when the link
    runs the same node major version; anything else stays an error, never a silent switch."""
    link = keg_link(missing)
    if link is None or not link.is_file() or not isinstance(recorded_version, str):
        return missing
    major = recorded_version.lstrip("v").split(".")[0]
    try:
        current = node_version(str(link)).lstrip("v").split(".")[0]
    except InstallError:
        return missing
    return str(link) if current == major else missing


def missing_extensions(prefix: Path) -> List[str]:
    return [rel for rel in dict.fromkeys(ROOT_EXTENSIONS + LANE_EXTENSIONS + DISPATCH_EXTENSIONS)
            if not (prefix / "extensions" / rel).is_file()]


def render(text: str, variables: Dict[str, str]) -> str:
    for key, value in variables.items():
        text = text.replace("{{" + key + "}}", value)
    return text


def template_vars(home: Path, prefix: Path, extra: Dict[str, str]) -> Dict[str, str]:
    return {**extra, "HOME": str(home), "PREFIX": str(prefix), "USER_HOME": str(USER_HOME)}


def keep_runtime_settings(data: bytes, target: Path) -> bytes:
    """Carry the keys pi writes into settings.json at runtime over the rendered template."""
    try:
        current = json.loads(target.read_text())
    except (OSError, ValueError):
        return data
    template = json.loads(data)
    # A key the template sets is managed: the template wins.
    kept = {key: current[key] for key in PI_RUNTIME_SETTINGS if key in current and key not in template}
    if not kept:
        return data
    return (json.dumps({**template, **kept}, indent=2) + "\n").encode()


def same_json(target: Path, data: bytes) -> bool:
    try:
        return json.loads(target.read_text()) == json.loads(data)
    except (OSError, ValueError):
        return False


def append_lane_policy(text: str, policy: str) -> str:
    """Append `policy` after the marker line to an agent file that sets `inheritGlobalContext: false`.
    Idempotent: anything already after the marker is replaced. Other files come back unchanged."""
    front = re.match(r"---\n(.*?)\n---\n", text, re.DOTALL)
    if not front or not re.search(r"^inheritGlobalContext:\s*false\s*$", front.group(1), re.MULTILINE):
        return text
    head = text.partition("\n" + LANE_POLICY_MARKER)[0]
    return head.rstrip("\n") + "\n\n" + LANE_POLICY_MARKER + "\n" + policy.strip("\n") + "\n"


def home_plan(prefix: Path, home: Path, variables: Dict[str, str]) -> Dict[str, bytes]:
    """Managed home files, rendered for this home and prefix."""
    plan: Dict[str, bytes] = {}
    template = prefix / "home"
    values = template_vars(home, prefix, variables)
    policy_file = template / LANE_POLICY
    policy = render(policy_file.read_text(), values) if policy_file.is_file() else None
    for path in sorted(template.rglob("*")):
        if path.is_dir() or "__pycache__" in path.parts:
            continue
        rel = path.relative_to(template).as_posix()
        if rel in NEVER_MANAGED:
            raise InstallError(f"home template must never carry {rel}")
        data = path.read_bytes()
        try:
            data = render(data.decode(), values).encode()
        except UnicodeDecodeError:
            pass
        if policy is not None and rel.startswith("agents/") and rel.endswith(".md"):
            data = append_lane_policy(data.decode(), policy).encode()
        plan[rel] = data
    for name in HOME_TOOLS:
        if (prefix / "bin" / name).is_file():
            plan[f"bin/{name}"] = (prefix / "bin" / name).read_bytes()
    return plan


def loop_pi_settings(prefix: Path) -> dict:
    try:
        value = json.loads((prefix / "home/settings.json").read_text()).get("loopPi", {})
    except (OSError, ValueError):
        return {}
    return value if isinstance(value, dict) else {}


def root_route(prefix: Path) -> Tuple[str, str, str]:
    route = {**DEFAULT_ROOT_ROUTE, **loop_pi_settings(prefix).get("rootRoute", {})}
    for key, value in route.items():
        if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9._:/-]+", value):
            raise InstallError(f"loopPi.rootRoute.{key} must be a plain identifier")
    return route["provider"], route["model"], route["thinking"]


def dispatch_launcher_name(launcher: str) -> str:
    """loop-pi -> loop-pi-dispatch, loop-pi-fast -> loop-pi-dispatch-fast; other names get a -dispatch suffix."""
    if launcher == "loop-pi" or launcher.startswith("loop-pi-"):
        return "loop-pi-dispatch" + launcher[len("loop-pi"):]
    return launcher + "-dispatch"


def node_major_guard(node: str) -> List[str]:
    """A keg link follows its formula across major versions; refuse to start on a different major
    rather than switch runtimes silently. Other node paths are fixed binaries and need no guard."""
    if not CELLAR_NODE.fullmatch(str(Path(node).resolve())) or keg_link(str(Path(node).resolve())) != Path(node):
        return []
    major = node_version(node).lstrip("v").split(".")[0]
    return [
        f"case \"$('{node}' --version 2>/dev/null || true)\" in",
        f"  v{major}.*) ;;",
        f"  *) echo \"loop-pi: {node} is no longer node {major}; re-run the installer\" >&2; exit 78 ;;",
        "esac",
    ]


def launcher_preamble(prefix: Path, home: Path, node: str, generated_by: str) -> List[str]:
    pi = prefix / PI_CLI
    return [
        "#!/bin/sh",
        f"# Generated by {generated_by}. Do not edit; re-run the installer.",
        "set -eu",
        *node_major_guard(node),
        f"export PI_CODING_AGENT_DIR='{home}'",
        f"export PI_SUBAGENTS_TEMP_ROOT='{home}/tmp'",
        "export PI_SKIP_VERSION_CHECK=1",
        "export PI_TELEMETRY=0",
        "export PI_SUBAGENT_WAIT_TOOL_ENABLED=false",
        'case "${1-}" in',
        f"  --version|-v) exec '{node}' '{pi}' --version ;;",
        "esac",
    ]


def loop_run_lines(prefix: Path, home: Path, name: str, indent: str, hint: str = "") -> List[str]:
    """Run dir, preflight and audit snapshot for a loop start in "$repo"."""
    lines = [
        f"mkdir -p '{home}/runs'",
        f'run_dir=$(mktemp -d "{home}/runs/$(date -u +%Y%m%dT%H%M%SZ)-$(basename "$repo")-XXXXXX")',
        f"if ! '{prefix}/bin/loop-pi-preflight' \"$repo\" >&2; then",
        '  rmdir "$run_dir"',
        f'  echo "{name}: preflight refused $repo.{hint}" >&2',
        "  exit 78",
        "fi",
        'export LOOP_PI_RUN_DIR="$run_dir" LOOP_PI_REPO="$repo"',
        f"if ! '{prefix}/bin/loop-pi-audit' begin \"$repo\" >&2; then",
        '  rm -f "$run_dir/.audit.lock" "$run_dir/audit-before.json"',
        '  rmdir "$run_dir" 2>/dev/null || true',
        f'  echo "{name}: cannot take the audit snapshot of $repo; not starting." >&2',
        "  exit 78",
        "fi",
        f'echo "{name}: run dir $run_dir" >&2',
    ]
    return [indent + line for line in lines]


def incomplete_lines(manifest: dict, name: str) -> List[str]:
    missing = ", ".join(manifest["missing_extensions"])
    return [f"echo '{name}: build {manifest['label']} is incomplete (missing: {missing}); only --version runs.' >&2",
            "exit 78"]


def dispatch_launcher_text(prefix: Path, home: Path, node: str, manifest: dict, name: str,
                           generated_by: str) -> str:
    """The thin dispatcher: always a loop run, no LLM root (extensions/dispatcher)."""
    pi = prefix / PI_CLI
    lines = launcher_preamble(prefix, home, node, generated_by)
    if manifest["missing_extensions"]:
        lines += incomplete_lines(manifest, name)
    else:
        flags = " ".join(f"--extension '{prefix / 'extensions' / rel}'" for rel in DISPATCH_EXTENSIONS)
        lines += [
            "unset LOOP_PI_RUN_DIR LOOP_PI_REPO",
            'if ! repo=$(git rev-parse --show-toplevel 2>/dev/null); then',
            f'  echo "{name}: run it inside the loop repository." >&2',
            "  exit 78",
            "fi",
            *loop_run_lines(prefix, home, name, ""),
            f"exec '{node}' '{pi}' -p --no-tools --provider loop-dispatch --model idle {flags} \"$@\"",
        ]
    return "\n".join(lines) + "\n"


def launcher_text(prefix: Path, home: Path, node: str, manifest: dict, name: str, generated_by: str) -> str:
    pi = prefix / PI_CLI
    lines = launcher_preamble(prefix, home, node, generated_by)
    if manifest["missing_extensions"]:
        lines += incomplete_lines(manifest, name)
    else:
        flags = " ".join(f"--extension '{prefix / 'extensions' / rel}'" for rel in ROOT_EXTENSIONS)
        provider, model, thinking = root_route(prefix)
        # Inside a git repo every start is a loop run with its own run dir, so concurrent loops
        # never share a before-snapshot. --plain skips it for an ordinary session.
        lines += [
            "unset LOOP_PI_RUN_DIR LOOP_PI_REPO",
            "plain=0",
            'if [ "${1-}" = "--plain" ]; then plain=1; shift; fi',
            'if [ "$plain" = 0 ] && repo=$(git rev-parse --show-toplevel 2>/dev/null); then',
            *loop_run_lines(prefix, home, name, "  ", f" Fix it, or run {name} --plain for a non-loop session."),
            "fi",
        ]
        # subagent is loaded up front and bg_wait is never declared: some OpenAI-compatible proxies
        # never acknowledge a request whose tool list grew mid-conversation (subagents_enable does
        # that), and `waitTool: false` leaves bg_wait declared although the root waits by push.
        lines.append(f"exec '{node}' '{pi}' {flags} --exclude-tools subagents_enable,bg_wait "
                     f"--provider {provider} --model {model} "
                     f'--thinking {thinking} "$@"')
    return "\n".join(lines) + "\n"


def run(cmd: List[str], cwd: Path) -> str:
    result = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if result.returncode:
        raise InstallError(f"{' '.join(cmd)} failed ({result.returncode}):\n{result.stderr[-2000:]}")
    return result.stdout


def check_model_family(prefix: Path) -> None:
    family = {**DEFAULT_FAMILY, **loop_pi_settings(prefix).get("modelFamily", {})}
    try:
        pattern = re.compile(family["pattern"])
    except (re.error, TypeError):
        raise InstallError("loopPi.modelFamily.pattern does not compile") from None
    provider = re.escape(family["provider"])
    for path in sorted((prefix / "home/agents").glob("*.md")):
        front = re.match(r"---\n(.*?)\n---\n", path.read_text(), re.DOTALL)
        match = front and re.search(rf"^model:\s*{provider}/(\S+)\s*$", front.group(1), re.MULTILINE)
        if not match or not pattern.search(match.group(1)):
            raise InstallError(f"agent {path.stem} must name a {family['provider']}/{family['name']} family model")
    _, model, _ = root_route(prefix)
    if not pattern.search(model):
        raise InstallError(f"loopPi.rootRoute.model is outside the {family['name']} family")


def check_agent_set(prefix: Path) -> None:
    found = {path.stem for path in (prefix / "home/agents").glob("*.md")}
    if found != AGENT_SET:
        raise InstallError(f"agent set differs from the loop-pi set: extra {sorted(found - AGENT_SET)}, "
                           f"missing {sorted(AGENT_SET - found)}")


def required_hook_scripts(prefix: Path) -> List[str]:
    value = loop_pi_settings(prefix).get("requiredHookScripts", [])
    if not isinstance(value, list) or not all(isinstance(item, str) and "/" not in item for item in value):
        raise InstallError("loopPi.requiredHookScripts must be a list of script file names")
    return value


def check_hook_scripts(prefix: Path) -> None:
    for name in required_hook_scripts(prefix):
        if not (prefix / "home/scripts" / name).is_file():
            raise InstallError(f"required hook script {name} is missing from the build (add it to overlay/scripts/)")


def smoke_extensions(prefix: Path, node: str, entries: Tuple[str, ...]) -> None:
    """Load the entries in a throwaway pi home (RPC mode) and require pi to answer get_commands."""
    with tempfile.TemporaryDirectory(prefix="loop-pi-smoke-") as home:
        env = {**os.environ, "PI_CODING_AGENT_DIR": home, "PI_SUBAGENTS_TEMP_ROOT": f"{home}/tmp",
               "PI_OFFLINE": "1", "PI_SKIP_VERSION_CHECK": "1", "PI_TELEMETRY": "0"}
        flags = [arg for rel in entries for arg in ("--extension", str(prefix / "extensions" / rel))]
        proc = subprocess.Popen([node, str(prefix / PI_CLI), "--mode", "rpc", "--no-session", *flags],
                                cwd=home, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True)
        try:
            out, err = proc.communicate('{"id":"smoke","type":"get_commands"}\n', timeout=120)
        except subprocess.TimeoutExpired:
            proc.kill()
            out, err = proc.communicate()
        if proc.returncode not in (0, None, -9) or "Failed to load extension" in err:
            raise InstallError(f"extension smoke failed for {', '.join(entries)}:\n{err[-2000:]}")
        for line in out.splitlines():
            try:
                reply = json.loads(line)
            except ValueError:
                continue
            if reply.get("id") == "smoke" and reply.get("success"):
                names = {command.get("name") for command in reply["data"]["commands"]}
                if SMOKE_COMMAND in names or "loop-wait/root.ts" not in entries:
                    return
        raise InstallError(f"extension smoke failed for {', '.join(entries)}:\n{err[-2000:]}")


def validate(prefix: Path, pin: Dict[str, str], node: str, allow_missing: bool) -> List[str]:
    for name, version in pin.items():
        installed = json.loads((prefix / "node_modules" / name / "package.json").read_text())["version"]
        if installed != version:
            raise InstallError(f"{name} installed {installed}, pinned {version}")
    reported = run([node, str(prefix / PI_CLI), "--version"], prefix).strip()
    if reported != pin[PI_PACKAGE]:
        raise InstallError(f"pi --version printed {reported!r}, pinned {pin[PI_PACKAGE]}")
    missing = missing_extensions(prefix)
    if missing and not allow_missing:
        raise InstallError("missing extension entries: " + ", ".join(missing))
    check_hook_scripts(prefix)
    check_agent_set(prefix)
    check_model_family(prefix)
    if not missing:
        smoke_extensions(prefix, node, ROOT_EXTENSIONS)
        smoke_extensions(prefix, node, LANE_EXTENSIONS)
        smoke_extensions(prefix, node, DISPATCH_EXTENSIONS)
    return missing


def source_commit(src: Path) -> str:
    return subprocess.run(["git", "-C", str(src), "rev-parse", "HEAD"], capture_output=True,
                          text=True).stdout.strip()


def build(data: Path, label: str, files: List[Tuple[str, Path]], pin: Dict[str, str], node: str,
          allow_missing: bool, policy_source: str, provenance: Dict[str, str]) -> Path:
    prefix = data / label
    if prefix.exists():
        manifest = json.loads((prefix / BUILD_MANIFEST).read_text())
        if manifest.get("label") != label:
            raise InstallError(f"{prefix} exists with a different build manifest")
        if manifest["missing_extensions"] and not allow_missing:
            raise InstallError(f"{prefix} is an incomplete build; remove it or pass --allow-missing-extensions")
        return prefix
    data.mkdir(parents=True, exist_ok=True)
    staging = data / f".staging-{label}"
    if staging.exists():
        if any(staging.iterdir()):
            raise InstallError(f"staging directory {staging} is not empty; inspect and remove it")
    else:
        staging.mkdir()
    try:
        for rel, source in files:
            target = staging / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)
        apply_overlay_settings(staging)
        render_policy(staging, policy_source)
        shutil.rmtree(staging / "overlay", ignore_errors=True)
        run(["npm", "ci", "--omit=dev", "--ignore-scripts", "--no-audit", "--no-fund"], staging)
        missing = validate(staging, pin, node, allow_missing)
    except BaseException:
        # The staging tree holds only copies of source and overlay files, and npm output.
        shutil.rmtree(staging, ignore_errors=True)
        raise
    manifest = {"label": label, "pins": pin, "node": node, "missing_extensions": missing, **provenance}
    (staging / BUILD_MANIFEST).write_text(json.dumps(manifest, indent=2) + "\n")
    os.rename(staging, prefix)
    return prefix


def atomic_write(path: Path, data: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


class Target:
    """One home and its launcher: everything `drift` needs besides the build."""

    def __init__(self, home: Path, bin_dir: Path, launcher: str, variables: Optional[Dict[str, str]] = None,
                 generated_by: str = "loop-pi-install", external: Tuple[str, ...] = (), variant: str = ""):
        self.home, self.bin_dir, self.launcher = home, bin_dir, launcher
        self.variant = variant
        self.variables = dict(variables or {})
        self.generated_by = generated_by
        self.external = tuple(external)


def drift(prefix: Path, target: Target, node: str,
          version: Optional[str] = None) -> List[Tuple[Path, bytes, int]]:
    manifest = json.loads((prefix / BUILD_MANIFEST).read_text())
    home = target.home
    changes = []
    plan = home_plan(prefix, home, target.variables)
    for rel, data in plan.items():
        path = home / rel
        mode = 0o755 if rel.startswith(("scripts/", "bin/")) else 0o644
        if rel == "settings.json":
            data = keep_runtime_settings(data, path)
            if same_json(path, data):
                continue
        if not path.is_file() or path.read_bytes() != data:
            changes.append((path, data, mode))
    receipt = {"label": manifest["label"], "files": sorted(set(plan) | set(target.external))}
    if target.variant:
        receipt["variant"] = target.variant
    if version is not None:
        receipt["node"] = {"path": node, "version": version}
    record = json.dumps(receipt, indent=2).encode() + b"\n"
    if not (home / HOME_MANIFEST).is_file() or (home / HOME_MANIFEST).read_bytes() != record:
        changes.append((home / HOME_MANIFEST, record, 0o644))
    for name in CLI_TOOLS:
        data = (prefix / "bin" / name).read_bytes()
        path = target.bin_dir / name
        if not path.is_file() or path.read_bytes() != data:
            changes.append((path, data, 0o755))
    dispatch = dispatch_launcher_name(target.launcher)
    for name, text in ((target.launcher, launcher_text), (dispatch, dispatch_launcher_text)):
        launcher = text(prefix, home, node, manifest, name, target.generated_by).encode()
        path = target.bin_dir / name
        if not path.is_file() or path.read_bytes() != launcher:
            changes.append((path, launcher, 0o755))
    return changes


def stale_managed(home: Path, plan_files: set, external: Tuple[str, ...] = ()) -> List[str]:
    try:
        previous = json.loads((home / HOME_MANIFEST).read_text())["files"]
    except (OSError, ValueError, KeyError):
        return []
    return sorted(set(previous) - plan_files - set(external))


def parse_vars(items: List[str]) -> Dict[str, str]:
    variables = {}
    for item in items:
        key, sep, value = item.partition("=")
        if not sep or not re.fullmatch(r"[A-Z][A-Z0-9_]*", key) or key in ("HOME", "PREFIX", "USER_HOME"):
            raise InstallError(f"--var takes KEY=VALUE with an upper-case KEY other than HOME, PREFIX, USER_HOME")
        variables[key] = value
    return variables


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--home", type=Path, required=True, help="the pi home to install (PI_CODING_AGENT_DIR)")
    parser.add_argument("--launcher", required=True, help="launcher file name written into --bin")
    parser.add_argument("--data", type=Path, default=DEFAULT_DATA, help="where builds live")
    parser.add_argument("--bin", type=Path, default=DEFAULT_BIN, help="where the launcher and CLIs go")
    parser.add_argument("--overlay", type=Path, help="overlay directory (see above)")
    parser.add_argument("--var", action="append", default=[], metavar="KEY=VALUE", help="extra {{KEY}} substitution")
    parser.add_argument("--generated-by", default="loop-pi-install", help="named in the launcher header")
    parser.add_argument("--policy-source", default="the loop-pi home templates",
                        help="named in the AGENTS.md banner as what to edit instead")
    parser.add_argument("--external-managed", action="append", default=[], metavar="REL",
                        help="home file another tool writes; recorded as managed, never written or reported stale")
    parser.add_argument("--variant", default="", help="home variant name, recorded in the home receipt")
    parser.add_argument("--source-repo", default="", help="recorded in the build manifest")
    parser.add_argument("--overlay-commit", default="", help="recorded in the build manifest")
    parser.add_argument("--node", help="absolute node executable (overrides LOOP_PI_NODE and recorded node)")
    parser.add_argument("--check", action="store_true", help="report drift, write nothing")
    parser.add_argument("--allow-missing-extensions", action="store_true",
                        help="bootstrap only: install a build whose launcher runs --version and nothing else")
    args = parser.parse_args(argv)
    try:
        if not re.fullmatch(r"[A-Za-z0-9._-]+", args.launcher):
            raise InstallError("--launcher must be a plain file name")
        if args.variant and not re.fullmatch(r"[A-Za-z0-9._-]+", args.variant):
            raise InstallError("--variant must be a plain name")
        variables = parse_vars(args.var)
        target = Target(args.home.expanduser(), args.bin.expanduser(), args.launcher, variables,
                        args.generated_by, tuple(args.external_managed), args.variant)
        pin = pins()
        files = source_files(SRC, args.overlay)
        label = build_label(files, pin, f"{args.policy_source}\0{args.generated_by}")
        node = node_binary(args.node, target.home)
        version = node_version(node)
        data = args.data.expanduser()
        prefix = data / label
        if args.check:
            if not (prefix / BUILD_MANIFEST).is_file():
                print(f"DRIFT: build {label} is not installed under {data}")
                return 1
            changes = drift(prefix, target, node, version)
            for path, _, _ in changes:
                print(f"DRIFT: {path}")
            stale = stale_managed(target.home, set(home_plan(prefix, target.home, variables)), target.external)
            for rel in stale:
                print(f"STALE: {target.home / rel} is no longer managed")
            if not changes and not stale:
                print(f"OK: {label} installed; home and launcher match")
            return 1 if changes or stale else 0
        provenance = {"source_repo": args.source_repo, "source_commit": source_commit(SRC),
                      "overlay_commit": args.overlay_commit}
        prefix = build(data, label, files, pin, node, args.allow_missing_extensions, args.policy_source, provenance)
        target.home.mkdir(mode=0o700, parents=True, exist_ok=True)
        (target.home / "tmp").mkdir(mode=0o700, exist_ok=True)
        stale = stale_managed(target.home, set(home_plan(prefix, target.home, variables)), target.external)
        for path, data_bytes, mode in drift(prefix, target, node, version):
            atomic_write(path, data_bytes, mode)
            print(f"wrote {path}")
        for rel in stale:
            print(f"STALE (left in place): {target.home / rel}")
        manifest = json.loads((prefix / BUILD_MANIFEST).read_text())
        if manifest["missing_extensions"]:
            print("incomplete build, launcher runs --version only: " + ", ".join(manifest["missing_extensions"]))
        print(f"installed {label} at {prefix}")
        return 0
    except InstallError as error:
        print(f"loop-pi-install: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
