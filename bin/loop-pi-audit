#!/usr/bin/env python3
"""Closeout remote-change audit for loop-pi runs.

`snapshot --out FILE REPO...` records, for each repository, every remote's
`git ls-remote --symref` output and URL, local tags, and `gh release list` (recorded as unavailable
rather than empty when `gh` cannot be used).

`compare BEFORE AFTER [--push-log FILE] [--run-dir DIR]` diffs two snapshots and lists every added,
moved or deleted remote ref, local tag and release. A default-branch move can be accounted for as
described below; every other change is UNGRANTED, except refs/pull/* changes, which are reported as
FOREIGN and are not violations. Peeled tags follow their tag. A repository missing from either
snapshot, or a remote, tag list or release list unreadable on either side, is UNVERIFIED.
Exit codes: 0 when nothing changed or every change is accounted for, 1 when any change is not,
2 on invalid input.

Per-run form, used by the `loop-pi` launcher so concurrent runs never share a snapshot. The run
dir comes from `--run-dir` or `LOOP_PI_RUN_DIR`, and a lock in it serialises these commands:
- `begin REPO` writes `<run-dir>/audit-before.json`, refusing (exit 1, no file) if any remote,
  tag list or release list cannot be read;
- `add REPO` adds another repository to that before-snapshot, same rule, never replacing a
  repository's first snapshot;
- `retain-protocol` records protocol evidence in an existing before-snapshot without taking a new
  one (exit 2 without the marker);
- `closeout [--push-log FILE]` snapshots every repo in it to `<run-dir>/audit-after.json` and
  compares.

Default-branch moves are judged commit by commit when the run dir holds the `loop-pi-proto`
marker (written when loop-continuation arms a launch), when either snapshot retains protocol
evidence (its `protocol` field), or when `--push-log` is passed. Every commit in `before..after`
must satisfy one of:
- it lies in some `old..new` range of the push log (`--push-log FILE`, default
  `<run-dir>/push-log.jsonl`, lines `{"repo", "remote", "ref", "old", "new", ...}`) for that
  repository, remote and ref;
- it touches only paths under `backlog/`.
Two more commits are accounted for: a FOREIGN one (not in the log, but its message ends with the
`Claude-Session:` trailer of a different harness session AND a logged `actor: root` push was made on
top of it; reported, not a violation) and, when the charter grants releases for the repository, a
release-please merge (see below). Anything else is UNGRANTED and named in a `note:` line. The fast-forward check still
applies. A derived `HEAD` move follows the default branch's verdict.

`--charter FILE --charter-sha256 HEX` (on `closeout` and `compare`) names the charter frozen at arm. A
charter that no longer hashes to the digest grants nothing. An `authority:` entry grants releases
when one of its clauses names release-please without a negation; it covers the repositories it
names (`owner/name` of a remote URL, or an absolute path), or the charter's own repository when it
names none. There a release-please merge (subject `chore(...): release ...` changing
`.release-please-manifest.json`), the new version tag on that commit, the release for that tag and
the deletion of a `release-please--*` branch are GRANTED. Legacy snapshots without protocol
evidence keep the old behaviour: no default-branch move is accounted for. Protocol evidence is
retained in the before-snapshot once observed, and an explicit --push-log also requires it, so
deleting the marker cannot downgrade those audits.

`--state-log FILE` (on `closeout` and `compare`) replaces typing the digest: it is the `charter_sha256`
of the first `open` event in the run's state log, which must carry `by: ext` (the harness writes it at
arm; a root's own append is `by: root`). A log that is unreadable, has any non-empty line before that
event which is not a UTF-8 JSON object, has no `open` event, a first one not written by the harness or
without a valid digest, or a `--charter-sha256` that disagrees with it, grants nothing (fail closed, a
warning on stderr).

A local tag that is new since the before-snapshot but whose name and target already appear in that
snapshot's refs for some remote was fetched, not created: it is reported as FETCHED and is not a
violation. A new local tag with no such remote counterpart, or one at a different target, is UNGRANTED.

Endpoint-equivalent aliases: a push-log line whose `actor` is `root`, whose `old` is an exact SHA
and whose `repo` is itself a snapshot key, with that remote's URL unchanged between snapshots, also
covers the same ref in any other snapshotted remote whose unchanged URL is byte-identical. No URL
normalisation: a different scheme, SSH user, host case or path spelling is a different endpoint.
Only absolute URLs qualify (scheme://, scp-like host:path, absolute local path); a relative URL
such as `../up.git` never transfers. An alias receives only those exact `old..new` ranges, never
the canonical's backlog verdict, current SHA or commit metadata, and a note names the canonical
receipt source.

A push the log never saw (a watcher, a subprocess, a script) is UNGRANTED: Git author, committer,
a checkout's current SHA and the remote's final state are never evidence of a root push. This
audit-side fail-closed report is deliberate; refusing such pushes before mutation in loop-guard was
considered and not chosen.

Stdlib only.
"""
import argparse
import fcntl
import hashlib
import json
import re
import os
import shutil
import subprocess
import sys
import time


def run(cmd: list[str], timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def git_remotes(repo: str) -> list[str]:
    result = run(["git", "-C", repo, "remote"])
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def git_ls_remote_refs(repo: str, remote: str) -> dict:
    """{"available": True, "refs": {ref: sha, ...}} or {"available": False, "reason": ...}."""
    try:
        result = run(["git", "-C", repo, "ls-remote", "--symref", remote], timeout=120)
    except subprocess.TimeoutExpired:
        return {"available": False, "reason": f"git ls-remote {remote} timed out"}
    except OSError as exc:
        return {"available": False, "reason": f"git ls-remote {remote} failed to run: {exc}"}
    if result.returncode != 0:
        return {"available": False, "reason": f"git ls-remote {remote} exited {result.returncode}: {result.stderr.strip()}"}
    refs: dict[str, str] = {}
    symrefs: dict[str, str] = {}
    for line in result.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        parts = line.split("\t", 1)
        if len(parts) != 2:
            continue
        sha, ref = parts
        if sha.startswith("ref: "):
            symrefs[ref] = sha[5:]
        else:
            refs[ref] = sha
    return {"available": True, "refs": refs, "symrefs": symrefs}


def git_local_tags(repo: str) -> dict:
    """{"available": True, "tags": {tag: sha, ...}} or {"available": False, "reason": ...}."""
    try:
        result = run(["git", "-C", repo, "show-ref", "--tags"])
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"available": False, "reason": f"git show-ref --tags failed: {exc}"}
    # Exit 1 with empty stdout means "no tags", not a failure.
    if result.returncode not in (0, 1):
        return {"available": False, "reason": f"git show-ref --tags exited {result.returncode}: {result.stderr.strip()}"}
    tags: dict[str, str] = {}
    for line in result.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        parts = line.split(" ", 1)
        if len(parts) != 2:
            continue
        sha, ref = parts
        tags[ref] = sha
    return {"available": True, "tags": tags}


def remote_host(url: str) -> str | None:
    """Host of a network remote URL (scheme://[user@]host[:port]/... or scp-like user@host:path).
    None for a local path or file:// remote, which could be anything and is left to gh."""
    m = re.match(r"^[a-z][a-z0-9+.-]*://(?:[^@/]*@)?([^:/]+)", url)
    if m:
        return None if url.startswith("file://") else m.group(1).lower()
    m = re.match(r"^(?:[^@/:]+@)?([^/:]+):(?!//)", url)
    if m and not os.path.exists(url):
        return m.group(1).lower()
    return None


def gh_configured_hosts() -> set[str]:
    """Hosts gh is logged in to (top-level keys of $GH_CONFIG_DIR/hosts.yml), so a GitHub
    Enterprise host counts as GitHub even when GH_HOST is unset."""
    config_dir = os.environ.get("GH_CONFIG_DIR") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "gh"
    )
    try:
        with open(os.path.join(config_dir, "hosts.yml")) as fh:
            lines = fh.read().splitlines()
    except OSError:
        return set()
    return {m.group(1).lower() for line in lines if (m := re.match(r"^([A-Za-z0-9.-]+):\s*$", line))}


def has_only_non_github_remotes(repo: str) -> bool:
    """True when the repository has remotes and every fetch and push URL is a network URL on a
    host that is neither github.com, $GH_HOST nor a host gh is configured for. The URLs Git
    resolves (insteadOf rewrites applied) are read, so an alias that expands to GitHub is still
    treated as GitHub."""
    github_hosts = {"github.com", os.environ.get("GH_HOST", "github.com").lower()} | gh_configured_hosts()
    hosts = []
    for remote in git_remotes(repo):
        for extra in ([], ["--push"]):
            result = run(["git", "-C", repo, "remote", "get-url", *extra, "--all", remote])
            urls = result.stdout.split() if result.returncode == 0 else []
            if not urls:
                return False
            for url in urls:
                host = remote_host(url)
                if host is None:
                    return False
                hosts.append(host)
    return bool(hosts) and not any(h in github_hosts or h.endswith(".github.com") for h in hosts)


def gh_release_list_in(repo: str) -> dict:
    """{"available": True, "releases": [...]} or {"available": False, "reason": ...}.

    Never conflates "gh unavailable/failed" with "zero releases": a
    successful call with no releases is {"available": True, "releases": []}.
    Runs with cwd=repo so `gh` resolves the repository from its git remotes.
    A repository whose remotes are all on non-GitHub hosts (Forgejo) has no
    GitHub releases: it is recorded as available, empty and noted, without gh.
    """
    if has_only_non_github_remotes(repo):
        return {"available": True, "releases": [], "note": "no GitHub remote; releases not applicable"}
    if shutil.which("gh") is None:
        return {"available": False, "reason": "gh is not installed"}
    try:
        result = subprocess.run(
            ["gh", "release", "list", "--json", "tagName,name,publishedAt,isDraft,isPrerelease", "--limit", "1000"],
            capture_output=True,
            text=True,
            timeout=60,
            cwd=repo,
        )
    except subprocess.TimeoutExpired:
        return {"available": False, "reason": "gh release list timed out"}
    except OSError as exc:
        return {"available": False, "reason": f"gh release list failed to run: {exc}"}
    if result.returncode != 0:
        return {"available": False, "reason": f"gh release list exited {result.returncode}: {result.stderr.strip()}"}
    try:
        releases = json.loads(result.stdout or "[]")
    except json.JSONDecodeError as exc:
        return {"available": False, "reason": f"gh release list returned unparseable JSON: {exc}"}
    return {"available": True, "releases": releases}


def snapshot_repo(repo: str) -> dict:
    remotes = {}
    for remote in git_remotes(repo):
        remotes[remote] = git_ls_remote_refs(repo, remote)
        try:
            url = run(["git", "-C", repo, "remote", "get-url", remote])
            if url.returncode == 0 and url.stdout.strip():
                remotes[remote]["url"] = url.stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            pass  # Missing identity never makes a remote endpoint-equivalent.
    return {
        "remotes": remotes,
        "tags": git_local_tags(repo),
        "releases": gh_release_list_in(repo),
    }


def cmd_snapshot(args: argparse.Namespace) -> int:
    snapshot = {
        "taken_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "repos": {repo: snapshot_repo(repo) for repo in args.repos},
    }
    with open(args.out, "w", encoding="utf-8") as fh:
        json.dump(snapshot, fh, indent=2, sort_keys=True)
        fh.write("\n")
    print(f"loop-pi-audit: wrote snapshot of {len(args.repos)} repo(s) to {args.out}")
    return 0


def unavailable_parts(entry: dict) -> list[str]:
    parts = [f"remote {name}: {r['reason']}" for name, r in entry["remotes"].items() if not r["available"]]
    parts += [f"{key}: {entry[key]['reason']}" for key in ("tags", "releases") if not entry[key]["available"]]
    return parts


def run_dir_of(args: argparse.Namespace) -> str:
    run_dir = args.run_dir or os.environ.get("LOOP_PI_RUN_DIR")
    if not run_dir or not os.path.isdir(run_dir):
        print("loop-pi-audit: no run dir (pass --run-dir or start the loop with loop-pi, which sets LOOP_PI_RUN_DIR).",
              file=sys.stderr)
        sys.exit(2)
    return run_dir


def write_json(path: str, data: dict) -> None:
    tmp = f"{path}.tmp-{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)


def add_to_before(args: argparse.Namespace, fresh: bool) -> int:
    run_dir = run_dir_of(args)
    before_path = os.path.join(run_dir, "audit-before.json")
    repo = os.path.realpath(args.repo)
    # Held through the read-modify-write so concurrent adds in one run keep every repo.
    with open(os.path.join(run_dir, ".audit.lock"), "w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return add_locked(before_path, repo, fresh, is_proto2(run_dir))


def add_locked(before_path: str, repo: str, fresh: bool, proto: bool = False) -> int:
    if not fresh:
        with open(before_path, "r", encoding="utf-8") as fh:
            before = json.load(fh)
        if proto and before.get("protocol") != 2:
            before["protocol"] = 2
            write_json(before_path, before)
        if repo in before["repos"]:
            # A later snapshot would hide every change made since the first one.
            print(f"loop-pi-audit: {repo} is already recorded in {before_path}; keeping the first snapshot.")
            return 0
    entry = snapshot_repo(repo)
    missing = unavailable_parts(entry)
    if missing:
        print(f"loop-pi-audit: cannot audit {repo}; the closeout comparison would fail:", file=sys.stderr)
        for part in missing:
            print(f"  {part}", file=sys.stderr)
        return 1
    if fresh:
        before = {"taken_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "repos": {}}
    if proto:
        before["protocol"] = 2
    before["repos"][repo] = entry
    write_json(before_path, before)
    print(f"loop-pi-audit: {repo} recorded in {before_path}")
    return 0


def cmd_begin(args: argparse.Namespace) -> int:
    return add_to_before(args, fresh=True)


def cmd_add(args: argparse.Namespace) -> int:
    return add_to_before(args, fresh=False)


def cmd_retain_protocol(args: argparse.Namespace) -> int:
    """Arm-time upgrade of a launcher's pre-arm snapshot, never a new remote snapshot."""
    run_dir = run_dir_of(args)
    with open(os.path.join(run_dir, ".audit.lock"), "w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not is_proto2(run_dir):
            print("loop-pi-audit: retain-protocol requires the armed protocol marker", file=sys.stderr)
            return 2
        before_path = os.path.join(run_dir, "audit-before.json")
        if not os.path.exists(before_path):
            # No baseline is invented. A later begin observes the marker; extension closeout
            # also retains its armed state and always supplies the explicit push-log path.
            return 0
        try:
            with open(before_path, encoding="utf-8") as fh:
                before = json.load(fh)
            if not isinstance(before, dict) or not isinstance(before.get("repos"), dict):
                raise ValueError("before-snapshot has no repository map")
            before["protocol"] = 2
            write_json(before_path, before)
        except (OSError, ValueError) as exc:
            print(f"loop-pi-audit: could not retain protocol: {exc}", file=sys.stderr)
            return 2
    return 0


def cmd_closeout(args: argparse.Namespace) -> int:
    run_dir = run_dir_of(args)
    with open(os.path.join(run_dir, ".audit.lock"), "w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return closeout_locked(run_dir, args.push_log, args.charter, args.charter_sha256,
                              args.state_log)


PUSH_LOG_HELP = "Push log (default: <run-dir>/push-log.jsonl)."
CHARTER_HELP = ("The run's charter. Its `authority:` entries that name release-please grant that repository's "
                "release merge, version tag, release and release-branch deletion.")
CHARTER_SHA_HELP = "sha256 of the charter as frozen at arm; a charter that no longer hashes to it grants nothing."
STATE_LOG_HELP = ("The run's state log. Its first `open` event holds the charter sha256 frozen at arm, used as "
                  "the digest for --charter (an explicit --charter-sha256 must agree).")


def closeout_locked(run_dir: str, push_log: str | None = None, charter: str | None = None,
                    charter_sha256: str | None = None, state_log: str | None = None) -> int:
    before_path = os.path.join(run_dir, "audit-before.json")
    with open(before_path, "r", encoding="utf-8") as fh:
        repos = sorted(json.load(fh)["repos"])
    after_path = os.path.join(run_dir, "audit-after.json")
    write_json(after_path, {"taken_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                            "repos": {repo: snapshot_repo(repo) for repo in repos}})
    return cmd_compare(argparse.Namespace(before=before_path, after=after_path, push_log=push_log,
                                          run_dir=run_dir, charter=charter, charter_sha256=charter_sha256,
                                          state_log=state_log))


def diff_ref_map(before: dict, after: dict) -> list[tuple[str, str, str, str]]:
    """Returns (change, ref, before_sha, after_sha) tuples; change in
    {"added", "deleted", "moved"}."""
    changes = []
    for ref in sorted(set(before) | set(after)):
        b, a = before.get(ref), after.get(ref)
        if b is None and a is not None:
            changes.append(("added", ref, "", a))
        elif b is not None and a is None:
            changes.append(("deleted", ref, b, ""))
        elif b != a:
            changes.append(("moved", ref, b, a))
    return changes


def fetch_ref(repo: str, remote: str, ref: str, timeout: int = 60) -> tuple[bool, str]:
    """Best-effort fetch of one ref from one remote, into `repo`'s own object
    database, so a subsequent `merge-base --is-ancestor` has the objects it
    needs even when they were never fetched during the run itself."""
    try:
        result = run(["git", "-C", repo, "fetch", remote, ref], timeout=timeout)
    except subprocess.TimeoutExpired:
        return False, f"git fetch {remote} {ref} timed out"
    except OSError as exc:
        return False, f"git fetch {remote} {ref} failed to run: {exc}"
    if result.returncode != 0:
        return False, f"git fetch {remote} {ref} exited {result.returncode}: {result.stderr.strip()}"
    return True, ""


def is_fast_forward(repo: str, before_sha: str, after_sha: str) -> tuple[bool | None, str]:
    """Returns (True, "") if before_sha is an ancestor of after_sha (a
    fast-forward move), (False, "") if it definitely is not, or (None,
    reason) when ancestry could not be determined (missing objects, a bad
    revision, ...)."""
    try:
        result = run(["git", "-C", repo, "merge-base", "--is-ancestor", before_sha, after_sha])
    except subprocess.TimeoutExpired:
        return None, "git merge-base --is-ancestor timed out"
    except OSError as exc:
        return None, f"git merge-base --is-ancestor failed to run: {exc}"
    if result.returncode == 0:
        return True, ""
    if result.returncode == 1:
        return False, ""
    return None, f"git merge-base --is-ancestor exited {result.returncode}: {result.stderr.strip()}"


def moved_ref_mark(repo: str, remote: str, ref: str, before_sha: str, after_sha: str, covered: bool,
                   foreign: bool = False) -> tuple[str, bool]:
    """Checks a moved remote ref for fast-forward ancestry: a non-fast-forward
    move is a violation even when every commit in it is accounted for. Fetches
    the ref fresh from the remote first so the ancestry check has the objects it
    needs. Returns (mark, all_covered_contribution)."""
    fetched, fetch_reason = fetch_ref(repo, remote, ref)
    if not fetched:
        return f"UNVERIFIED fast-forward: {fetch_reason}", False
    ff, ff_reason = is_fast_forward(repo, before_sha, after_sha)
    if ff is None:
        return f"UNVERIFIED fast-forward: {ff_reason}", False
    if not ff:
        return ("NON-FAST-FORWARD (granted, but blocked)" if covered else "NON-FAST-FORWARD UNGRANTED"), False
    return ("FOREIGN" if covered and foreign else "GRANTED" if covered else "UNGRANTED"), covered


def head_target(entry: dict, other: dict) -> str | None:
    """Resolve legacy snapshots conservatively, without consulting moving live state."""
    explicit = entry.get("symrefs", {}).get("HEAD")
    if explicit:
        return explicit
    refs = entry.get("refs", {})
    sha = refs.get("HEAD")
    if sha is None:
        return None
    candidates = [ref for ref, value in refs.items()
                  if ref.startswith("refs/heads/") and value == sha]
    hint = other.get("symrefs", {}).get("HEAD")
    if hint in candidates:
        return hint
    return candidates[0] if len(candidates) == 1 else None


PROTO_MARKER = "loop-pi-proto"


def is_proto2(run_dir: str | None) -> bool:
    return bool(run_dir) and os.path.isfile(os.path.join(run_dir, PROTO_MARKER))


def valid_receipt_remote(value: object) -> bool:
    """A single named remote, not absent, a list, a URL or an option. Never infer origin."""
    if (not isinstance(value, str) or not value or value.startswith("-")
            or re.search(r"[\x00-\x20\x7f~^:?*\[\\]", value)
            or any(part in value for part in ("..", "@{", "//"))):
        return False
    return all(part and not part.startswith(".") and not part.endswith((".", ".lock"))
               for part in value.split("/"))


def load_push_log(path: str | None) -> list[dict]:
    """Well-formed push-log records; unreadable lines are skipped (they grant nothing)."""
    entries: list[dict] = []
    if not path:
        return entries
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if (isinstance(obj, dict) and isinstance(obj.get("repo"), str) and isinstance(obj.get("ref"), str)
                        and valid_receipt_remote(obj.get("remote"))
                        and isinstance(obj.get("new"), str) and re.fullmatch(r"[0-9a-f]{40}", obj["new"])
                        and (obj.get("old") is None or (isinstance(obj["old"], str)
                                                         and re.fullmatch(r"[0-9a-f]{40}", obj["old"])))):
                    entries.append(obj)
    except OSError:
        pass
    return entries


def rev_list(repo: str, spec: str) -> list[str] | None:
    try:
        result = run(["git", "-C", repo, "rev-list", spec], timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout.split() if result.returncode == 0 else None


def repository_identity(repo: str) -> str | None:
    """The shared git directory, not a remote URL: linked worktrees are the same repository,
    but independent clones sharing a remote must never inherit each other's logged pushes."""
    try:
        result = run(["git", "-C", repo, "rev-parse", "--path-format=absolute", "--git-common-dir"])
    except (OSError, subprocess.TimeoutExpired):
        return None
    return os.path.realpath(result.stdout.strip()) if result.returncode == 0 and result.stdout.strip() else None


def matching_pushes(repo: str, remote: str, ref: str, push_log: list[dict]) -> list[dict]:
    """Push-log entries for exactly this repository, named remote and ref."""
    real = os.path.realpath(repo)
    identity = repository_identity(repo)
    matched: list[dict] = []
    identities: dict[str, str | None] = {}
    for entry in push_log:
        if (entry["ref"] != ref or not valid_receipt_remote(entry.get("remote"))
                or entry["remote"] != remote):
            continue
        logged_repo = os.path.realpath(entry["repo"])
        if logged_repo != real:
            if logged_repo not in identities:
                identities[logged_repo] = repository_identity(logged_repo)
            if identity is None or identities[logged_repo] != identity:
                continue
        matched.append(entry)
    return matched


def logged_commits(repo: str, remote: str, ref: str, push_log: list[dict]) -> set[str]:
    """Commits inside logged ranges for exactly this repository, named remote and ref."""
    covered: set[str] = set()
    for entry in matching_pushes(repo, remote, ref, push_log):
        commits = rev_list(repo, f"{entry['old']}..{entry['new']}" if entry.get("old") else entry["new"])
        if commits:
            covered.update(commits)
    return covered


def touches_only_backlog(repo: str, sha: str) -> bool:
    parents = run(["git", "-C", repo, "rev-list", "--parents", "-n", "1", sha]).stdout.split()[1:]
    if parents:
        cmd = ["git", "-C", repo, "diff-tree", "-r", "-z", "--name-only", "--no-commit-id", parents[0], sha]
    else:
        cmd = ["git", "-C", repo, "diff-tree", "-r", "-z", "--name-only", "--no-commit-id", "--root", sha]
    result = run(cmd)
    paths = [p for p in result.stdout.split("\0") if p]
    return result.returncode == 0 and bool(paths) and all(p.startswith("backlog/") for p in paths)


# --- Charter release authority and foreign pushes -------------------------------------------------

RELEASE_MANIFEST = ".release-please-manifest.json"
RELEASE_CONFIG = "release-please-config.json"
# Files a release-please pull request writes: the manifest, changelogs and the common version files.
# Any other path it changes must be named under `extra-files` in the config the parent commit holds.
RELEASE_FILE_NAMES = frozenset({
    RELEASE_MANIFEST, RELEASE_CONFIG, "CHANGELOG.md", "version.txt", "VERSION", "package.json", "package-lock.json",
    "npm-shrinkwrap.json", "pyproject.toml", "uv.lock", "poetry.lock", "setup.py", "setup.cfg", "__init__.py",
    "_version.py", "version.py", "Cargo.toml", "Cargo.lock", "pom.xml", "Chart.yaml", "composer.json",
    "gradle.properties",
})
RELEASE_SUBJECT = re.compile(r"^chore(?:\([^)]*\))?!?: release\b", re.IGNORECASE)
RELEASE_BRANCH_PREFIX = "refs/heads/release-please--"
RELEASE_TAG = re.compile(r"^refs/tags/(?:[A-Za-z0-9_.-]+[@-])?v?\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.+-]+)?$")
NEGATION = re.compile(r"\b(?:no|not|never|without|forbid\w*|exclud\w*|except|cannot|can't|don't)\b", re.IGNORECASE)
CLAUSE_SPLIT = re.compile(r"(?<=[.;])\s+|;")
SLUG = re.compile(r"(?<![\w./-])([A-Za-z0-9_][A-Za-z0-9_.-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*)(?![\w/-])")
ABS_PATH = re.compile(r"(?<![\w.-])(/[^\s,;()`'\"]+)")


def charter_authority_entries(text: str) -> list[str]:
    """The charter's `authority:` grants, one string per entry: the key's own value, then each bullet
    under it (the `- ` removed), with wrapped continuation lines joined to their entry. The block ends
    at the next unindented line. Nothing outside it is authority."""
    entries: list[str] = []
    inside = False
    for line in text.splitlines():
        if inside and (not line.strip() or line[0] in " \t"):
            if not line.strip():
                continue
            bullet = re.match(r"^\s*[-*]\s+(.*)$", line)
            text = (bullet.group(1) if bullet else line).strip()
            # A new entry starts at a bullet; any other indented line continues the entry before it.
            if bullet or not entries:
                entries.append(text)
            else:
                entries[-1] += " " + text
            continue
        inside = False
        if line.startswith("## "):
            break
        m = re.match(r"^authority:[ \t]*(.*)$", line)
        if m:
            inside = True
            if m.group(1).strip():
                entries.append(m.group(1).strip())
    return entries


def release_grant_entries(text: str) -> list[dict]:
    """Authority entries that grant release-please releases: one clause names `release-please`
    with no negation in that clause. The entry's repositories are the `owner/name` slugs and
    absolute paths it names; an entry naming none grants the charter's own repository only."""
    grants = []
    for entry in charter_authority_entries(text):
        clauses = [c for c in CLAUSE_SPLIT.split(entry) if c and c.strip()]
        if not any(re.search(r"release-please", c, re.IGNORECASE) and not NEGATION.search(c) for c in clauses):
            continue
        slugs = {m.group(1).rstrip(".,:").lower() for m in SLUG.finditer(entry)}
        paths = {os.path.realpath(m.group(1).rstrip(".,:")) for m in ABS_PATH.finditer(entry)}
        grants.append({"slugs": slugs, "paths": paths})
    return grants


def read_release_authority(path: str | None, sha256: str | None) -> tuple[dict | None, str | None]:
    """(authority, None), or (None, why) when the charter cannot be used. The file must hash to the
    digest frozen at arm, so editing the charter after arm cannot grant anything."""
    if not path:
        return None, None
    if not sha256 or not re.fullmatch(r"[0-9a-fA-F]{64}", sha256):
        return None, "no valid --charter-sha256"
    try:
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError as exc:
        return None, f"cannot read {path}: {exc}"
    if hashlib.sha256(data).hexdigest() != sha256.lower():
        return None, f"{path} no longer matches the digest frozen at arm"
    folder = os.path.dirname(os.path.realpath(path))
    charter_repo = os.path.dirname(folder) if os.path.basename(folder) == "codex" else None
    return {"grants": release_grant_entries(data.decode("utf-8", "replace")), "charter_repo": charter_repo}, None


def state_log_charter_sha256(path: str | None) -> tuple[str | None, str | None]:
    """(digest, None) from the first `open` event of the state log, or (None, why). The log is written
    by the harness at arm, so the digest is the one frozen then, not one the root computed later."""
    if not path:
        return None, None
    try:
        with open(path, "rb") as fh:
            raw_lines = fh.read().splitlines()
    except OSError as exc:
        return None, f"cannot read state log {path}: {exc}"
    for number, raw in enumerate(raw_lines, 1):
        if not raw.strip():
            continue
        # Decoded record by record and only up to the first open event, so bytes after it never matter.
        # Any record before it that is not a UTF-8 JSON object (a BOM, a truncated line, nesting deep
        # enough to exhaust the parser) leaves the log without authority; none is skipped.
        try:
            event = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, ValueError, RecursionError) as exc:
            return None, f"cannot parse line {number} of state log {path}: {type(exc).__name__}"
        if not isinstance(event, dict):
            return None, f"line {number} of state log {path} is not an event"
        if event.get("ev") == "open":
            # The harness appends it with --by ext; loop-state gives a root's append by=root.
            if event.get("by") != "ext":
                return None, f"the first open event in {path} was not written by the harness"
            digest = event.get("charter_sha256")
            if isinstance(digest, str) and re.fullmatch(r"[0-9a-fA-F]{64}", digest):
                return digest.lower(), None
            return None, f"the open event in {path} carries no valid charter_sha256"
    return None, f"{path} has no open event"


def frozen_charter_digest(sha256: str | None, state_log: str | None) -> tuple[str | None, str | None]:
    """The digest to check the charter against: the state log's when given, which an explicit
    `--charter-sha256` must then equal."""
    if not state_log:
        return sha256, None
    digest, why = state_log_charter_sha256(state_log)
    if why:
        return None, why
    if sha256 and sha256.lower() != digest:
        return None, "--charter-sha256 differs from the state log's frozen charter digest"
    return digest, None


def repo_slugs(*entries: dict) -> set[str]:
    """`owner/name` of every remote URL in the snapshot entries, lowercased, `.git` removed."""
    slugs = set()
    for entry in entries:
        for remote in entry.get("remotes", {}).values():
            parts = [p for p in re.split(r"[:/]", remote.get("url", "")) if p]
            if len(parts) >= 2:
                slugs.add(f"{parts[-2]}/{re.sub(r'[.]git$', '', parts[-1])}".lower())
    return slugs


def authority_covers_release(authority: dict | None, repo: str, *entries: dict) -> bool:
    if not authority:
        return False
    real = os.path.realpath(repo)
    slugs = repo_slugs(*entries)
    for grant in authority["grants"]:
        if grant["slugs"] or grant["paths"]:
            if real in grant["paths"] or slugs & grant["slugs"]:
                return True
        elif authority.get("charter_repo") and os.path.realpath(authority["charter_repo"]) == real:
            return True
    return False


def commit_paths(repo: str, sha: str) -> list[str] | None:
    parents = run(["git", "-C", repo, "rev-list", "--parents", "-n", "1", sha]).stdout.split()[1:]
    cmd = (["git", "-C", repo, "diff-tree", "-r", "-z", "--name-only", "--no-commit-id", parents[0], sha] if parents
           else ["git", "-C", repo, "diff-tree", "-r", "-z", "--name-only", "--no-commit-id", "--root", sha])
    result = run(cmd)
    return [p for p in result.stdout.split("\0") if p] if result.returncode == 0 else None


def release_extra_files(repo: str, sha: str) -> set[str]:
    """`extra-files` paths the release config names in the commit's parent (never in the commit itself,
    which could widen its own allowance)."""
    shown = run(["git", "-C", repo, "show", f"{sha}^:{RELEASE_CONFIG}"])
    if shown.returncode != 0:
        return set()
    try:
        config = json.loads(shown.stdout)
    except ValueError:
        return set()
    scopes = [config] + [v for v in (config.get("packages") or {}).values() if isinstance(v, dict)] \
        if isinstance(config, dict) else []
    found: set[str] = set()
    for scope in scopes:
        for item in scope.get("extra-files") or []:
            path = item.get("path") if isinstance(item, dict) else item
            if isinstance(path, str) and path:
                found.add(path.lstrip("/"))
    return found


def is_release_commit(repo: str, sha: str) -> bool:
    """The shape of a release-please merge: its release subject, a change to the manifest only a
    release-please pull request makes, and no change outside the files release-please writes (see
    RELEASE_FILE_NAMES, plus the config's `extra-files`). Authority comes from the charter, never from
    this shape."""
    subject = run(["git", "-C", repo, "log", "-1", "--format=%s", sha])
    paths = commit_paths(repo, sha) or []
    if not (subject.returncode == 0 and RELEASE_SUBJECT.match(subject.stdout.strip()) and RELEASE_MANIFEST in paths):
        return False
    extra = release_extra_files(repo, sha)
    return all(os.path.basename(p) in RELEASE_FILE_NAMES or p in extra or any(p.endswith("/" + e) for e in extra)
               for p in paths)


def peel_commit(repo: str, sha: str) -> str | None:
    result = run(["git", "-C", repo, "rev-parse", "--verify", "--quiet", f"{sha}^{{commit}}"])
    return result.stdout.strip() if result.returncode == 0 and result.stdout.strip() else None


def release_tag_granted(repo: str, remote: str | None, ref: str, sha: str, release_shas: set[str]) -> bool:
    """A new version tag pointing at a release-please merge this audit accounted for."""
    if not RELEASE_TAG.match(ref.removesuffix("^{}")):
        return False
    if ref.endswith("^{}"):
        return sha in release_shas
    if remote is not None:
        fetch_ref(repo, remote, ref)
    commit = peel_commit(repo, sha)
    return commit is not None and commit in release_shas


SESSION_TRAILER = re.compile(r"^Claude-Session:[ \t]*(\S+)[ \t]*$", re.MULTILINE)


def foreign_session(repo: str, sha: str, roots: list[dict]) -> tuple[str, dict] | None:
    """(session, push) when `sha` is another session's commit the root integrated, else None.

    Two independent facts are both required. The commit's own final paragraph carries the
    `Claude-Session:` trailer Claude Code writes on every commit it makes (a loop-pi root writes
    none); and `sha` is the `old` of, or an ancestor of the `old` of, a logged `actor: root` push, so
    the root pushed on top of it and it was on the remote before that push. The trailer alone is text
    anyone can write, and the receipt alone cannot tell a sibling from an unlogged writer of this
    run, so neither downgrades UNGRANTED by itself. The result is FOREIGN, never a grant; Git author
    and committer are still never read."""
    body = run(["git", "-C", repo, "log", "-1", "--format=%B", sha])
    if body.returncode != 0:
        return None
    # Only the final paragraph is a trailer block; the same text higher up is just prose.
    match = SESSION_TRAILER.search(body.stdout.rstrip().rsplit("\n\n", 1)[-1])
    if not match:
        return None
    for entry in roots:
        if run(["git", "-C", repo, "merge-base", "--is-ancestor", sha, entry["old"]]).returncode == 0:
            return match.group(1), entry
    return None


def stable_endpoint(b: dict, a: dict) -> str | None:
    """The remote URL both snapshots read, byte for byte, or None. No normalisation."""
    url = b.get("url")
    if (b.get("available") and a.get("available") and isinstance(url, str) and url
            and url == a.get("url") and not re.search(r"[\r\n\x00]", url)):
        return url
    return None


def absolute_endpoint(url: str) -> bool:
    """A URL whose text names one endpoint wherever it is read: scheme://..., scp-like
    [user@]host:path, or an absolute local path. Relative paths resolve per checkout, and so
    may a remote helper's <transport>::<address>, so neither is absolute."""
    if "::" in url:
        return False
    return bool(re.match(r"[A-Za-z][A-Za-z0-9+.-]*://", url) or re.match(r"[^/:]+:", url)
                or os.path.isabs(url))


def endpoint_receipts(before_repos: dict, after_repos: dict, push_log: list[dict]) -> dict[str, list[dict]]:
    """Root push receipts that endpoint-equivalent aliases may spend, keyed by exact endpoint URL.

    A receipt qualifies only when its actor is the root, it names an exact `old` (never a creation,
    whose range would be all history), and its `repo` is itself a snapshot key whose named remote
    read the same URL before and after the run. An alias is endpoint-equivalent only when its own
    remote URL is byte-identical to that one: no scheme, user, host-case, port or path normalisation,
    so a different SSH user, scheme or `.git` spelling is a different endpoint and fails closed.
    Only absolute URLs qualify (scheme://, scp-like host:path or an absolute local path): the same
    relative text such as `../up.git` names a different repository in each checkout. Aliases receive
    only these exact `old..new` ranges: never the canonical's backlog rule outcome, current SHA or
    commit authorship."""
    keys = {os.path.realpath(key): key for key in set(before_repos) & set(after_repos)}
    receipts: dict[str, list[dict]] = {}
    for entry in push_log:
        if entry.get("actor") != "root" or not isinstance(entry.get("old"), str):
            continue
        key = keys.get(os.path.realpath(entry["repo"]))
        if key is None:
            continue
        url = stable_endpoint(before_repos[key].get("remotes", {}).get(entry["remote"], {}),
                              after_repos[key].get("remotes", {}).get(entry["remote"], {}))
        if url is not None and absolute_endpoint(url):
            receipts.setdefault(url, []).append({**entry, "canonical": key})
    return receipts


def default_move_verdict(repo: str, remote: str, ref: str, before_sha: str, after_sha: str,
                         push_log: list[dict],
                         alias_receipts: list[dict] | None = None,
                         release: bool = False,
                         release_shas: set[str] | None = None) -> tuple[bool, list[str], set[str]]:
    """Is every commit in before..after accounted for? Returns (covered, notes, kinds).

    Besides a logged push and a `backlog/`-only change, a commit is accounted for when it is a
    release-please merge and `release` is set (the charter's authority names releases for this
    repository; `release_shas` collects those commits), or FOREIGN: it names another harness session
    in its final `Claude-Session:` trailer AND a logged root push was made on top of it (see
    foreign_session). `kinds` holds "foreign" when any commit was accounted for that way.

    Only a journaled successful push counts as a push. A push made by a watcher, subprocess or any
    other path the push log never saw is UNGRANTED here: it is never inferred from Git author or
    committer, the checkout's current SHA or the remote's final state. This audit-side fail-closed
    report is the chosen answer for such pushes; refusing them before mutation in loop-guard was
    deliberately not chosen."""
    fetched, reason = fetch_ref(repo, remote, ref)
    if not fetched:
        return False, [f"cannot verify commits: {reason}"], set()
    commits = rev_list(repo, f"{before_sha}..{after_sha}")
    if commits is None:
        return False, [f"cannot list commits {before_sha[:12]}..{after_sha[:12]}"], set()
    logged = logged_commits(repo, remote, ref, push_log)
    roots = [e for e in matching_pushes(repo, remote, ref, push_log)
             if e.get("actor") == "root" and isinstance(e.get("old"), str)]
    aliased: dict[str, str] = {}
    for entry in alias_receipts or []:
        if entry["ref"] == ref:
            for sha in rev_list(repo, f"{entry['old']}..{entry['new']}") or []:
                aliased.setdefault(sha, f"{entry['canonical']} remote '{entry['remote']}'")
    uncovered = []
    accounted: list[str] = []
    kinds: set[str] = set()
    via_alias: dict[str, int] = {}
    for sha in commits:
        if sha in logged or touches_only_backlog(repo, sha):
            continue
        if sha in aliased:
            via_alias[aliased[sha]] = via_alias.get(aliased[sha], 0) + 1
            continue
        if release and is_release_commit(repo, sha):
            if release_shas is not None:
                release_shas.add(sha)
            accounted.append(f"commit {sha[:12]} is a release-please merge, covered by the charter's release authority")
            continue
        foreign = foreign_session(repo, sha, roots)
        if foreign is not None:
            session, basis = foreign
            kinds.add("foreign")
            accounted.append(f"commit {sha[:12]} is FOREIGN: not in a logged push, it names another session "
                             f"({session}), and the root's logged push {basis['old'][:12]}..{basis['new'][:12]} "
                             f"was made on top of it")
            continue
        uncovered.append(f"commit {sha[:12]} is not in a logged push and is not backlog-only")
    notes = [f"{count} commit(s) covered by endpoint-equivalent root push receipts journaled for {source}"
             for source, count in sorted(via_alias.items())]
    return not uncovered, notes + accounted + uncovered, kinds


def compare_repo(name: str, before: dict, after: dict, report: list[str],
                 seen_granted: set | None = None, proto: dict | None = None) -> bool:
    """Returns True if every change is accounted for or foreign. `proto` is
    {"push_log": [...], "endpoints": {...}}: default-branch moves are then judged commit by commit;
    without it no remote change is accounted for."""
    all_covered = True
    # Release-please merges the charter's authority covers (the commits found so far, across remotes)
    # and the version tags those commits earned.
    release_ok = proto is not None and authority_covers_release(proto.get("authority"), name, before, after)
    release_shas: set[str] = set()
    granted_tags: set[str] = set()

    before_remotes = before.get("remotes", {})
    after_remotes = after.get("remotes", {})

    for remote in sorted(set(before_remotes) | set(after_remotes)):
        b = before_remotes.get(remote, {"available": False, "reason": "remote absent before"})
        a = after_remotes.get(remote, {"available": False, "reason": "remote absent after"})
        if not b.get("available") or not a.get("available"):
            report.append(
                f"[{name}] remote '{remote}': ls-remote unavailable on one side "
                f"(before={b.get('reason', 'ok')!r}, after={a.get('reason', 'ok')!r}); UNVERIFIED - cannot "
                f"confirm no ungranted change occurred."
            )
            all_covered = False
            continue
        url = b.get("url") if b.get("url") == a.get("url") else None
        defaults: set[str] = set()
        verdicts: dict[str, tuple[bool, list[str], set[str]]] = {}
        if proto is not None:
            defaults = {t for t in (head_target(b, a), head_target(a, b)) if t}
            if not defaults:
                defaults = {"refs/heads/main", "refs/heads/master"}

        def default_verdict(ref: str) -> tuple[bool, list[str], set[str]]:
            if ref not in verdicts:
                before_sha, after_sha = b.get("refs", {}).get(ref), a.get("refs", {}).get(ref)
                if before_sha and after_sha and before_sha != after_sha:
                    # A receipt names a remote, not a transferable URL alias. Missing/changed
                    # snapshot identity cannot spend it on the new endpoint. Backlog-only
                    # evidence is independent of the endpoint.
                    # An endpoint-equivalent alias (byte-identical stable URL) may also spend the
                    # canonical repository's exact root push ranges for this ref, and nothing else.
                    endpoint = stable_endpoint(b, a)
                    verdicts[ref] = default_move_verdict(
                        name, remote, ref, before_sha, after_sha, proto["push_log"] if endpoint else [],
                        proto.get("endpoints", {}).get(endpoint, []) if endpoint else [],
                        release_ok, release_shas)
                else:
                    verdicts[ref] = (False, [], set())
            return verdicts[ref]

        def accounted_release_commits() -> set[str]:
            for default in sorted(defaults):
                default_verdict(default)
            return release_shas
        changes = diff_ref_map(b.get("refs", {}), a.get("refs", {}))
        before_head = b.get("symrefs", {}).get("HEAD")
        after_head = a.get("symrefs", {}).get("HEAD")
        # Missing metadata in a legacy snapshot is not itself a retargeting.
        if (before_head and after_head and before_head != after_head
                and not any(ref == "HEAD" for _, ref, _, _ in changes)):
            changes.append(("retargeted", "HEAD", b.get("refs", {}).get("HEAD", ""),
                            a.get("refs", {}).get("HEAD", "")))
        for change, ref, before_sha, after_sha in changes:
            target = ref
            notes: list[str] = []
            if ref == "HEAD":
                targets = [head_target(entry, other) for entry, other, sha in
                           ((b, a, before_sha), (a, b, after_sha)) if sha]
                if not targets or any(t is None for t in targets):
                    mark = "UNVERIFIED HEAD target"
                    all_covered = False
                else:
                    covered = all(proto is not None and t in defaults and default_verdict(t)[0]
                                  for t in targets)
                    foreign = covered and any("foreign" in default_verdict(t)[2] for t in targets)
                    mark = ("FOREIGN derived HEAD" if foreign else "GRANTED derived HEAD") if covered else "UNGRANTED derived HEAD"
                    all_covered = all_covered and covered
            elif ref.startswith("refs/pull/"):
                mark = "FOREIGN"
            elif (release_ok and change == "deleted" and ref.startswith(RELEASE_BRANCH_PREFIX)
                  and accounted_release_commits()):
                mark = "GRANTED"
                notes = ["release-please branch removed after its merge, covered by the charter's release authority"]
            elif (release_ok and change == "added" and ref.startswith("refs/tags/")
                  and release_tag_granted(name, remote, ref, after_sha, accounted_release_commits())):
                mark = "GRANTED"
                granted_tags.add(ref.removesuffix("^{}").removeprefix("refs/tags/"))
                notes = ["version tag on a release-please merge, covered by the charter's release authority"]
            else:
                # A peeled tag (refs/tags/<t>^{}) follows its tag.
                if ref.startswith("refs/tags/") and ref.endswith("^{}"):
                    target = ref[:-3]
                covered = False
                foreign = False
                if proto is not None and change == "moved" and ref in defaults:
                    covered, notes, kinds = default_verdict(ref)
                    foreign = "foreign" in kinds
                if change == "moved" and ref == target:
                    mark, contributes_covered = moved_ref_mark(name, remote, ref, before_sha, after_sha, covered, foreign)
                    all_covered = all_covered and contributes_covered
                else:
                    all_covered = all_covered and covered
                    mark = "GRANTED" if covered else "UNGRANTED"
            # Deduplicate only verified granted outcomes, never violations or unknowns, and never a
            # line carrying notes (an alias's endpoint-equivalent evidence must stay visible).
            head_identity = (before_head, after_head) if ref == "HEAD" else ()
            key = (url, change, ref, before_sha, after_sha, head_identity, mark)
            if url and not notes and mark.startswith("GRANTED") and seen_granted is not None:
                if key in seen_granted:
                    continue
                seen_granted.add(key)
            report.append(f"[{name}] remote '{remote}' ref {change}: {ref} ({before_sha[:12] or '-'} -> {after_sha[:12] or '-'}) [{mark}]")
            for note in notes:
                report.append(f"[{name}] remote '{remote}' ref {change}: {ref} note: {note}")

    before_tags = before.get("tags", {})
    after_tags = after.get("tags", {})
    if not before_tags.get("available") or not after_tags.get("available"):
        report.append(
            f"[{name}] local tags: unavailable on one side "
            f"(before={before_tags.get('reason', 'ok')!r}, after={after_tags.get('reason', 'ok')!r}); UNVERIFIED - "
            f"cannot confirm no ungranted change occurred."
        )
        all_covered = False
    else:
        for change, ref, before_sha, after_sha in diff_ref_map(before_tags.get("tags", {}), after_tags.get("tags", {})):
            shown = f"[{name}] tag {change}: {ref} ({before_sha[:12] or '-'} -> {after_sha[:12] or '-'})"
            if (release_ok and change == "added"
                    and release_tag_granted(name, None, ref, after_sha, release_shas)):
                granted_tags.add(ref.removeprefix("refs/tags/"))
                report.append(f"{shown} [GRANTED]")
                report.append(f"{shown} note: version tag on a release-please merge, covered by the charter's release authority")
                continue
            fetched_from = sorted(r for r, entry in before_remotes.items()
                                  if change == "added" and entry.get("available") and after_sha
                                  and entry.get("refs", {}).get(ref) == after_sha)
            if fetched_from:
                report.append(f"{shown} [FETCHED]")
                report.append(f"{shown} note: already at this target on remote '{fetched_from[0]}' in the "
                              "before-snapshot; fetched, not created")
                continue
            all_covered = False
            report.append(f"{shown} [UNGRANTED]")

    before_releases = before.get("releases", {})
    after_releases = after.get("releases", {})
    if not before_releases.get("available") or not after_releases.get("available"):
        report.append(
            f"[{name}] releases: unavailable on one side "
            f"(before={before_releases.get('reason', 'ok')!r}, after={after_releases.get('reason', 'ok')!r}); "
            f"UNVERIFIED - cannot confirm no ungranted change occurred."
        )
        all_covered = False
    else:
        before_tags_set = {r["tagName"] for r in before_releases.get("releases", []) if "tagName" in r}
        after_tags_set = {r["tagName"] for r in after_releases.get("releases", []) if "tagName" in r}
        for tag in sorted(after_tags_set - before_tags_set):
            if release_ok and tag in granted_tags:
                report.append(f"[{name}] release added: {tag} [GRANTED]")
                report.append(f"[{name}] release added: {tag} note: published for a version tag covered by the charter's release authority")
                continue
            all_covered = False
            report.append(f"[{name}] release added: {tag} [UNGRANTED]")
        for tag in sorted(before_tags_set - after_tags_set):
            all_covered = False
            report.append(f"[{name}] release removed: {tag} [UNGRANTED]")

    return all_covered


def cmd_compare(args: argparse.Namespace) -> int:
    with open(args.before, "r", encoding="utf-8") as fh:
        before = json.load(fh)
    with open(args.after, "r", encoding="utf-8") as fh:
        after = json.load(fh)

    run_dir = getattr(args, "run_dir", None)
    proto_run = (is_proto2(run_dir) or before.get("protocol") == 2 or after.get("protocol") == 2
                 or getattr(args, "push_log", None) is not None)
    proto = None
    if proto_run:
        log_path = getattr(args, "push_log", None) or (os.path.join(run_dir, "push-log.jsonl") if run_dir else None)
        if not log_path or not os.path.isfile(log_path):
            print(f"loop-pi-audit: warning: no push log at {log_path}; default-branch moves are accounted for "
                  "only by backlog-only commits.", file=sys.stderr)
        proto = {"push_log": load_push_log(log_path)}
        charter = getattr(args, "charter", None)
        digest, why = frozen_charter_digest(getattr(args, "charter_sha256", None), getattr(args, "state_log", None))
        authority = None
        if not why:
            authority, why = read_release_authority(charter, digest)
        if why:
            print(f"loop-pi-audit: warning: the charter grants nothing ({why}); release-please changes stay UNGRANTED.",
                  file=sys.stderr)
        proto["authority"] = authority

    before_repos = before.get("repos", {})
    after_repos = after.get("repos", {})
    all_names = sorted(set(before_repos) | set(after_repos))
    if proto is not None:
        proto["endpoints"] = endpoint_receipts(before_repos, after_repos, proto["push_log"])

    seen_granted: set = set()
    report: list[str] = []
    all_ok = True
    any_change = False
    for name in all_names:
        if name not in before_repos or name not in after_repos:
            # A repo dropped from one snapshot entirely (a crashed run, a
            # wrong repo list, ...) can't be diffed at all, so it must never
            # be silently treated as "no remotes, nothing to check" - that
            # would hide every change made to it.
            missing_from = "before" if name not in before_repos else "after"
            report.append(f"[{name}] repository missing from the {missing_from} snapshot; UNVERIFIED - cannot confirm no ungranted change occurred.")
            all_ok = False
            any_change = True
            continue
        b = before_repos[name]
        a = after_repos[name]
        pre_len = len(report)
        covered = compare_repo(name, b, a, report, seen_granted, proto)
        if len(report) > pre_len:
            any_change = True
        all_ok = all_ok and covered

    if not any_change:
        print("loop-pi-audit: no remote changes detected.")
        return 0

    for line in report:
        print(line)

    if not all_ok:
        print("loop-pi-audit: at least one remote change is not accounted for.", file=sys.stderr)
        return 1
    print("loop-pi-audit: every remote change is accounted for.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    snap = sub.add_parser("snapshot", help="Record remote state for one or more repositories.")
    snap.add_argument("--out", required=True, help="Path to write the snapshot JSON.")
    snap.add_argument("repos", nargs="+", help="Repository paths to snapshot.")
    snap.set_defaults(func=cmd_snapshot)

    comp = sub.add_parser("compare", help="Compare two snapshots and report changes not accounted for.")
    comp.add_argument("before", help="Path to the before snapshot JSON.")
    comp.add_argument("after", help="Path to the after snapshot JSON.")
    comp.add_argument("--push-log", help=PUSH_LOG_HELP)
    comp.add_argument("--run-dir", help="Run directory; default-branch moves are judged against the push log "
                                        "when it holds loop-pi-proto (compare never reads $LOOP_PI_RUN_DIR).")
    comp.add_argument("--charter", help=CHARTER_HELP)
    comp.add_argument("--charter-sha256", help=CHARTER_SHA_HELP)
    comp.add_argument("--state-log", help=STATE_LOG_HELP)
    comp.set_defaults(func=cmd_compare)

    for name, func, text in (("begin", cmd_begin, "Start a run's before-snapshot with REPO."),
                             ("add", cmd_add, "Add REPO to a run's before-snapshot.")):
        p = sub.add_parser(name, help=text)
        p.add_argument("--run-dir", help="Run directory (default: $LOOP_PI_RUN_DIR).")
        p.add_argument("repo")
        p.set_defaults(func=func)

    retain = sub.add_parser("retain-protocol", help="Retain the armed protocol in an existing before-snapshot without resnapshotting.")
    retain.add_argument("--run-dir", help="Run directory (default: $LOOP_PI_RUN_DIR).")
    retain.set_defaults(func=cmd_retain_protocol)

    close = sub.add_parser("closeout", help="Snapshot the run's repos again and compare.")
    close.add_argument("--run-dir", help="Run directory (default: $LOOP_PI_RUN_DIR).")
    close.add_argument("--push-log", help=PUSH_LOG_HELP)
    close.add_argument("--charter", help=CHARTER_HELP)
    close.add_argument("--charter-sha256", help=CHARTER_SHA_HELP)
    close.add_argument("--state-log", help=STATE_LOG_HELP)
    close.set_defaults(func=cmd_closeout)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
