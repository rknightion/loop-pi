#!/usr/bin/env python3
"""Closeout remote-change audit for loop-pi runs.

`snapshot --out FILE REPO...` records, for each repository, every remote's
`git ls-remote --symref` output, local tags, and `gh release list` (recorded as unavailable rather
than empty when `gh` cannot be used).

`compare BEFORE AFTER [--grants FILE]` diffs two snapshots and lists every
added, moved or deleted ref, tag and release, marking each as covered or not
by a grants file (`{"<repo>": ["refs/heads/main", ...]}`, matched by the exact
repo key used on the snapshot command line). For remote refs, paths whose
snapshots record the same unchanged remote URL share explicit ref grants:
a granted move is reported once; ungranted moves remain visible under every
path. Legacy snapshots without URLs do not share grants. Local tags and
releases remain path-specific. Exits 1 if any change is not
covered by a grant. Ungranted refs/pull/* changes are reported as FOREIGN,
not violations. HEAD and peeled tags inherit their target's grant. A repo's
grants may also be {"refs": [...], "allow_non_fast_forward": [...]}; the
latter opts named, granted branches into expected history rewrites.

Per-run form, used by the `loop-pi` launcher so concurrent loops never share
a snapshot. The run dir comes from `--run-dir` or `LOOP_PI_RUN_DIR`:
- `begin REPO` writes `<run-dir>/audit-before.json`, refusing (exit 1, no
  file) if any remote, tag list or release list cannot be read;
- `add REPO` adds another repository to that before-snapshot, same rule;
- `closeout [--grants FILE] [--ops FILE]` snapshots every repo in it to
  `<run-dir>/audit-after.json` and compares.

`--ops FILE` (compare and closeout) is the loop's frozen ops grant file,
`{"v": 1, "ops": [{"surface", "kind", "allow", "secret_paths"?}, ...]}`, kept at
`<repo>/codex/ops-*.json`. When it holds an entry of kind `release`, a tag (remote
or local) or a GitHub release that was added during the run is covered (marked
`GRANTED ops release`) even without a ref grant, but only in the repository that
holds the ops file (realpath of the `codex/` directory's parent, compared with
the realpath of each snapshot repository key). An ops file outside a `codex/`
directory covers no repository. No other kind covers anything, and moved or
deleted tags and releases still need a ref grant. The `--grants` file is unchanged.
`--ops-sha256 HEX` is the sha256 the launch froze for that file (the `Ops grants:` line); a file
whose bytes no longer match is refused (exit 2) before it covers anything. `--ops` without it still
works, with a warning on stderr that the ops file is unverified.

Protocol 2: when the run dir holds `loop-pi-proto`, `closeout` (and `compare --run-dir DIR`)
grant a move of a remote's default branch only through the commits themselves, never through a
`refs/heads/<default>` entry in the grants file (such an entry is ignored, with a warning). Every
commit in `before..after` must satisfy one of:
- it lies in some `old..new` range of the push log (`--push-log FILE`, default
  `<run-dir>/push-log.jsonl`, lines `{"repo", "ref", "old", "new", ...}`) for that repository and ref;
- it touches only paths under `backlog/`;
- it lies in a range that a member of the repository's `bot_actors` list in the grants file (exact
  bot logins: letters, digits and hyphens followed by `[bot]`) itself pushed or merged inside the snapshot window,
  according to GitHub's activity API (push records, never author or committer metadata; missing
  evidence grants nothing).
Automation entries also accept exact `refs/tags/<tag>` selectors and literal tag prefixes
(e.g. `{"ref_prefix": "refs/tags/v", "actor": "release-please[bot]"}`). Unlike branch
prefixes, tag prefixes need not end in `/`, so one prefix can cover stable and rc tags.
Only added remote tags (including peeled refs), local tags and releases are covered: GitHub's
Releases API must return that exact tag with an `author.login` matching the granted bot.
Missing/unreadable evidence grants nothing. Existing release authors never authorize retags
or deletions. This attribution is independent of protocol 2 and never covers branches.

Anything else is UNGRANTED and named in a `note:` line. The fast-forward check still applies. A
derived `HEAD` move follows the default branch's verdict. Other refs, tags and releases are
unchanged. Legacy snapshots without protocol evidence keep the old behaviour. Protocol 2 is retained in the
before-snapshot once observed; an explicit --push-log also requires it. Deleting the marker cannot
downgrade those audits.

`--grants-sha256 HEX` (compare and closeout) is the sha256 the launch froze for the `--grants`
file; a file whose bytes differ is refused (exit 2) before it covers anything. Under protocol 2 a
`--grants` file without it still works, with a warning on stderr.

Stdlib only.
"""
import argparse
from datetime import datetime, timezone
from urllib.parse import quote, urlparse
import fcntl
import hashlib
import json
import re
import os
import shutil
import subprocess
import sys
import time


def run(cmd: list[str], timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def git_remotes(repo: str) -> list[str]:
    result = run(["git", "-C", repo, "remote"])
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def git_ls_remote_refs(repo: str, remote: str) -> dict:
    """{"available": True, "refs": {ref: sha, ...}} or {"available": False, "reason": ...}."""
    try:
        result = run(["git", "-C", repo, "ls-remote", "--symref", remote], timeout=120)
    except subprocess.TimeoutExpired:
        return {"available": False, "reason": f"git ls-remote {remote} timed out"}
    except OSError as exc:
        return {"available": False, "reason": f"git ls-remote {remote} failed to run: {exc}"}
    if result.returncode != 0:
        return {"available": False, "reason": f"git ls-remote {remote} exited {result.returncode}: {result.stderr.strip()}"}
    refs: dict[str, str] = {}
    symrefs: dict[str, str] = {}
    for line in result.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        parts = line.split("\t", 1)
        if len(parts) != 2:
            continue
        sha, ref = parts
        if sha.startswith("ref: "):
            symrefs[ref] = sha[5:]
        else:
            refs[ref] = sha
    return {"available": True, "refs": refs, "symrefs": symrefs}


def git_local_tags(repo: str) -> dict:
    """{"available": True, "tags": {tag: sha, ...}} or {"available": False, "reason": ...}."""
    try:
        result = run(["git", "-C", repo, "show-ref", "--tags"])
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"available": False, "reason": f"git show-ref --tags failed: {exc}"}
    # Exit 1 with empty stdout means "no tags", not a failure.
    if result.returncode not in (0, 1):
        return {"available": False, "reason": f"git show-ref --tags exited {result.returncode}: {result.stderr.strip()}"}
    tags: dict[str, str] = {}
    for line in result.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        parts = line.split(" ", 1)
        if len(parts) != 2:
            continue
        sha, ref = parts
        tags[ref] = sha
    return {"available": True, "tags": tags}


def remote_host(url: str) -> str | None:
    """Host of a network remote URL (scheme://[user@]host[:port]/... or scp-like user@host:path).
    None for a local path or file:// remote, which could be anything and is left to gh."""
    m = re.match(r"^[a-z][a-z0-9+.-]*://(?:[^@/]*@)?([^:/]+)", url)
    if m:
        return None if url.startswith("file://") else m.group(1).lower()
    m = re.match(r"^(?:[^@/:]+@)?([^/:]+):(?!//)", url)
    if m and not os.path.exists(url):
        return m.group(1).lower()
    return None


def gh_configured_hosts() -> set[str]:
    """Hosts gh is logged in to (top-level keys of $GH_CONFIG_DIR/hosts.yml), so a GitHub
    Enterprise host counts as GitHub even when GH_HOST is unset."""
    config_dir = os.environ.get("GH_CONFIG_DIR") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "gh"
    )
    try:
        with open(os.path.join(config_dir, "hosts.yml")) as fh:
            lines = fh.read().splitlines()
    except OSError:
        return set()
    return {m.group(1).lower() for line in lines if (m := re.match(r"^([A-Za-z0-9.-]+):\s*$", line))}


def has_only_non_github_remotes(repo: str) -> bool:
    """True when the repository has remotes and every fetch and push URL is a network URL on a
    host that is neither github.com, $GH_HOST nor a host gh is configured for. The URLs Git
    resolves (insteadOf rewrites applied) are read, so an alias that expands to GitHub is still
    treated as GitHub."""
    github_hosts = {"github.com", os.environ.get("GH_HOST", "github.com").lower()} | gh_configured_hosts()
    hosts = []
    for remote in git_remotes(repo):
        for extra in ([], ["--push"]):
            result = run(["git", "-C", repo, "remote", "get-url", *extra, "--all", remote])
            urls = result.stdout.split() if result.returncode == 0 else []
            if not urls:
                return False
            for url in urls:
                host = remote_host(url)
                if host is None:
                    return False
                hosts.append(host)
    return bool(hosts) and not any(h in github_hosts or h.endswith(".github.com") for h in hosts)


def gh_release_list_in(repo: str) -> dict:
    """{"available": True, "releases": [...]} or {"available": False, "reason": ...}.

    Never conflates "gh unavailable/failed" with "zero releases": a
    successful call with no releases is {"available": True, "releases": []}.
    Runs with cwd=repo so `gh` resolves the repository from its git remotes.
    A repository whose remotes are all on non-GitHub hosts (Forgejo) has no
    GitHub releases: it is recorded as available, empty and noted, without gh.
    """
    if has_only_non_github_remotes(repo):
        return {"available": True, "releases": [], "note": "no GitHub remote; releases not applicable"}
    if shutil.which("gh") is None:
        return {"available": False, "reason": "gh is not installed"}
    try:
        result = subprocess.run(
            ["gh", "release", "list", "--json", "tagName,name,publishedAt,isDraft,isPrerelease", "--limit", "1000"],
            capture_output=True,
            text=True,
            timeout=60,
            cwd=repo,
        )
    except subprocess.TimeoutExpired:
        return {"available": False, "reason": "gh release list timed out"}
    except OSError as exc:
        return {"available": False, "reason": f"gh release list failed to run: {exc}"}
    if result.returncode != 0:
        return {"available": False, "reason": f"gh release list exited {result.returncode}: {result.stderr.strip()}"}
    try:
        releases = json.loads(result.stdout or "[]")
    except json.JSONDecodeError as exc:
        return {"available": False, "reason": f"gh release list returned unparseable JSON: {exc}"}
    return {"available": True, "releases": releases}


def snapshot_repo(repo: str) -> dict:
    remotes = {}
    for remote in git_remotes(repo):
        remotes[remote] = git_ls_remote_refs(repo, remote)
        try:
            url = run(["git", "-C", repo, "remote", "get-url", remote])
            if url.returncode == 0 and url.stdout.strip():
                remotes[remote]["url"] = url.stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            pass  # Missing identity never permits sharing grants.
    return {
        "remotes": remotes,
        "tags": git_local_tags(repo),
        "releases": gh_release_list_in(repo),
    }


def cmd_snapshot(args: argparse.Namespace) -> int:
    snapshot = {
        "taken_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "repos": {repo: snapshot_repo(repo) for repo in args.repos},
    }
    with open(args.out, "w", encoding="utf-8") as fh:
        json.dump(snapshot, fh, indent=2, sort_keys=True)
        fh.write("\n")
    print(f"loop-pi-audit: wrote snapshot of {len(args.repos)} repo(s) to {args.out}")
    return 0


def unavailable_parts(entry: dict) -> list[str]:
    parts = [f"remote {name}: {r['reason']}" for name, r in entry["remotes"].items() if not r["available"]]
    parts += [f"{key}: {entry[key]['reason']}" for key in ("tags", "releases") if not entry[key]["available"]]
    return parts


def run_dir_of(args: argparse.Namespace) -> str:
    run_dir = args.run_dir or os.environ.get("LOOP_PI_RUN_DIR")
    if not run_dir or not os.path.isdir(run_dir):
        print("loop-pi-audit: no run dir (pass --run-dir or start the loop with loop-pi, which sets LOOP_PI_RUN_DIR).",
              file=sys.stderr)
        sys.exit(2)
    return run_dir


def write_json(path: str, data: dict) -> None:
    tmp = f"{path}.tmp-{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)


def add_to_before(args: argparse.Namespace, fresh: bool) -> int:
    run_dir = run_dir_of(args)
    before_path = os.path.join(run_dir, "audit-before.json")
    repo = os.path.realpath(args.repo)
    # Held through the read-modify-write so concurrent adds in one run keep every repo.
    with open(os.path.join(run_dir, ".audit.lock"), "w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return add_locked(before_path, repo, fresh, is_proto2(run_dir))


def add_locked(before_path: str, repo: str, fresh: bool, proto: bool = False) -> int:
    if not fresh:
        with open(before_path, "r", encoding="utf-8") as fh:
            before = json.load(fh)
        if proto and before.get("protocol") != 2:
            before["protocol"] = 2
            write_json(before_path, before)
        if repo in before["repos"]:
            # A later snapshot would hide every change made since the first one.
            print(f"loop-pi-audit: {repo} is already recorded in {before_path}; keeping the first snapshot.")
            return 0
    entry = snapshot_repo(repo)
    missing = unavailable_parts(entry)
    if missing:
        print(f"loop-pi-audit: cannot audit {repo}; the closeout comparison would fail:", file=sys.stderr)
        for part in missing:
            print(f"  {part}", file=sys.stderr)
        return 1
    if fresh:
        before = {"taken_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "repos": {}}
    if proto:
        before["protocol"] = 2
    before["repos"][repo] = entry
    write_json(before_path, before)
    print(f"loop-pi-audit: {repo} recorded in {before_path}")
    return 0


def cmd_begin(args: argparse.Namespace) -> int:
    return add_to_before(args, fresh=True)


def cmd_add(args: argparse.Namespace) -> int:
    return add_to_before(args, fresh=False)


def cmd_retain_protocol(args: argparse.Namespace) -> int:
    """Arm-time upgrade of a launcher's pre-arm snapshot, never a new remote snapshot."""
    run_dir = run_dir_of(args)
    with open(os.path.join(run_dir, ".audit.lock"), "w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not is_proto2(run_dir):
            print("loop-pi-audit: retain-protocol requires the armed protocol marker", file=sys.stderr)
            return 2
        before_path = os.path.join(run_dir, "audit-before.json")
        if not os.path.exists(before_path):
            # No baseline is invented. A later begin observes the marker; extension closeout
            # also retains its armed state and always supplies the explicit push-log path.
            return 0
        try:
            with open(before_path, encoding="utf-8") as fh:
                before = json.load(fh)
            if not isinstance(before, dict) or not isinstance(before.get("repos"), dict):
                raise ValueError("before-snapshot has no repository map")
            before["protocol"] = 2
            write_json(before_path, before)
        except (OSError, ValueError) as exc:
            print(f"loop-pi-audit: could not retain protocol: {exc}", file=sys.stderr)
            return 2
    return 0


def cmd_closeout(args: argparse.Namespace) -> int:
    run_dir = run_dir_of(args)
    with open(os.path.join(run_dir, ".audit.lock"), "w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return closeout_locked(run_dir, args.grants, args.ops, args.ops_sha256, args.grants_sha256, args.push_log)


OPS_KINDS = {"deploy", "probe", "release", "secret-write", "credential-create"}
OPS_SHA256_HELP = "The sha256 the launch froze for the --ops file; a mismatch refuses the audit (exit 2)."
GRANTS_SHA256_HELP = "The sha256 the launch froze for the --grants file; a mismatch refuses the audit (exit 2)."
PUSH_LOG_HELP = "Protocol 2 push log (default: <run-dir>/push-log.jsonl)."


def load_ops_release(path: str | None, sha256: str | None = None) -> set[str]:
    """Realpaths of the repositories a release-kind entry covers: at most the one holding the ops file.
    With `sha256`, the file's bytes must hash to it. Raises ValueError on a mismatch or a malformed file."""
    if path is None:
        if sha256 is not None:
            raise ValueError("--ops-sha256 needs --ops")
        return set()
    with open(path, "rb") as fh:
        raw = fh.read()
    if sha256 is None:
        print(f"loop-pi-audit: warning: ops file {path} is unverified; pass --ops-sha256 with the sha256 "
              "the launch froze for it.", file=sys.stderr)
    else:
        actual = hashlib.sha256(raw).hexdigest()
        if actual != sha256.strip().lower():
            raise ValueError(f"{path} has sha256 {actual}, which does not match --ops-sha256 {sha256}")
    data = json.loads(raw.decode("utf-8"))
    if not isinstance(data, dict) or data.get("v") != 1 or not isinstance(data.get("ops"), list):
        raise ValueError('expected {"v": 1, "ops": [...]}')
    for entry in data["ops"]:
        if not isinstance(entry, dict) or not isinstance(entry.get("surface"), str) or entry.get("kind") not in OPS_KINDS:
            raise ValueError(f"malformed ops entry: {entry!r}")
    if not any(entry["kind"] == "release" for entry in data["ops"]):
        return set()
    # A release grant covers only the repository holding the ops file, `<repo>/codex/ops-*.json`.
    codex = os.path.realpath(os.path.dirname(os.path.abspath(path)))
    if os.path.basename(codex) != "codex":
        print(f"loop-pi-audit: ops file {path} is not in a codex/ directory; its release entry covers no repository.",
              file=sys.stderr)
        return set()
    return {os.path.dirname(codex)}


def closeout_locked(run_dir: str, grants: str | None, ops: str | None = None, ops_sha256: str | None = None,
                    grants_sha256: str | None = None, push_log: str | None = None) -> int:
    before_path = os.path.join(run_dir, "audit-before.json")
    with open(before_path, "r", encoding="utf-8") as fh:
        repos = sorted(json.load(fh)["repos"])
    after_path = os.path.join(run_dir, "audit-after.json")
    write_json(after_path, {"taken_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                            "repos": {repo: snapshot_repo(repo) for repo in repos}})
    return cmd_compare(argparse.Namespace(before=before_path, after=after_path, grants=grants, ops=ops,
                                          ops_sha256=ops_sha256, grants_sha256=grants_sha256,
                                          push_log=push_log, run_dir=run_dir))


def diff_ref_map(before: dict, after: dict) -> list[tuple[str, str, str, str]]:
    """Returns (change, ref, before_sha, after_sha) tuples; change in
    {"added", "deleted", "moved"}."""
    changes = []
    for ref in sorted(set(before) | set(after)):
        b, a = before.get(ref), after.get(ref)
        if b is None and a is not None:
            changes.append(("added", ref, "", a))
        elif b is not None and a is None:
            changes.append(("deleted", ref, b, ""))
        elif b != a:
            changes.append(("moved", ref, b, a))
    return changes


def fetch_ref(repo: str, remote: str, ref: str, timeout: int = 60) -> tuple[bool, str]:
    """Best-effort fetch of one ref from one remote, into `repo`'s own object
    database, so a subsequent `merge-base --is-ancestor` has the objects it
    needs even when they were never fetched during the run itself."""
    try:
        result = run(["git", "-C", repo, "fetch", remote, ref], timeout=timeout)
    except subprocess.TimeoutExpired:
        return False, f"git fetch {remote} {ref} timed out"
    except OSError as exc:
        return False, f"git fetch {remote} {ref} failed to run: {exc}"
    if result.returncode != 0:
        return False, f"git fetch {remote} {ref} exited {result.returncode}: {result.stderr.strip()}"
    return True, ""


def is_fast_forward(repo: str, before_sha: str, after_sha: str) -> tuple[bool | None, str]:
    """Returns (True, "") if before_sha is an ancestor of after_sha (a
    fast-forward move), (False, "") if it definitely is not, or (None,
    reason) when ancestry could not be determined (missing objects, a bad
    revision, ...)."""
    try:
        result = run(["git", "-C", repo, "merge-base", "--is-ancestor", before_sha, after_sha])
    except subprocess.TimeoutExpired:
        return None, "git merge-base --is-ancestor timed out"
    except OSError as exc:
        return None, f"git merge-base --is-ancestor failed to run: {exc}"
    if result.returncode == 0:
        return True, ""
    if result.returncode == 1:
        return False, ""
    return None, f"git merge-base --is-ancestor exited {result.returncode}: {result.stderr.strip()}"


def moved_ref_mark(repo: str, remote: str, ref: str, before_sha: str, after_sha: str, covered: bool, allow_rewrite: bool = False) -> tuple[str, bool]:
    """Checks a moved remote ref for fast-forward ancestry (plan C4 item 5:
    "a moved ref must be checked for fast-forward ... A non-fast-forward move
    is a violation even when the branch is granted"). Fetches the ref fresh
    from the remote first so the ancestry check has the objects it needs.
    Returns (mark, all_covered_contribution)."""
    fetched, fetch_reason = fetch_ref(repo, remote, ref)
    if not fetched:
        return f"UNVERIFIED fast-forward: {fetch_reason}", False
    ff, ff_reason = is_fast_forward(repo, before_sha, after_sha)
    if ff is None:
        return f"UNVERIFIED fast-forward: {ff_reason}", False
    if not ff:
        if covered and allow_rewrite:
            return "GRANTED EXPECTED NON-FAST-FORWARD", True
        return ("NON-FAST-FORWARD (granted, but blocked)" if covered else "NON-FAST-FORWARD UNGRANTED"), False
    return ("GRANTED" if covered else "UNGRANTED"), covered


def head_target(entry: dict, other: dict) -> str | None:
    """Resolve legacy snapshots conservatively, without consulting moving live state."""
    explicit = entry.get("symrefs", {}).get("HEAD")
    if explicit:
        return explicit
    refs = entry.get("refs", {})
    sha = refs.get("HEAD")
    if sha is None:
        return None
    candidates = [ref for ref, value in refs.items()
                  if ref.startswith("refs/heads/") and value == sha]
    hint = other.get("symrefs", {}).get("HEAD")
    if hint in candidates:
        return hint
    return candidates[0] if len(candidates) == 1 else None


def validate_automation(grants_by_repo: dict) -> None:
    for grants in grants_by_repo.values():
        if isinstance(grants, dict) and "bot_actors" in grants:
            actors = grants["bot_actors"]
            if not isinstance(actors, list) or not all(
                    isinstance(a, str) and re.fullmatch(r"[A-Za-z0-9-]+\[bot\]", a) for a in actors):
                raise ValueError("bot_actors must be a list of exact GitHub App bot logins ending in [bot]")
        if not isinstance(grants, dict) or "automation" not in grants:
            continue
        items = grants["automation"]
        if not isinstance(items, list):
            raise ValueError("automation must be a list")
        for item in items:
            if not isinstance(item, dict) or set(item) not in (
                    {"ref", "actor"}, {"ref_prefix", "actor"}):
                raise ValueError("automation item needs exactly actor and ref or ref_prefix")
            actor = item["actor"]
            if not isinstance(actor, str) or not re.fullmatch(r"[A-Za-z0-9-]+\[bot\]", actor):
                raise ValueError("automation actor must be an exact GitHub App bot login ending in [bot]")
            ref = item.get("ref", item.get("ref_prefix"))
            namespace = next((ns for ns in ("refs/heads/", "refs/tags/")
                              if isinstance(ref, str) and ref.startswith(ns)), None)
            if (namespace is None or len(ref) <= len(namespace) or any(c in ref for c in " *?[:\\")
                    or any(ord(c) < 33 or ord(c) == 127 for c in ref)
                    or ".." in ref or "@{" in ref or "//" in ref
                    or ("ref_prefix" in item and namespace == "refs/heads/" and not ref.endswith("/"))
                    or ("ref" in item and (ref.endswith(("/", ".", ".lock"))))):
                raise ValueError("automation ref must be an exact branch or tag; branch prefix must end in /")
            # Git is the authority for ref syntax, including component restrictions.
            checked_ref = ref + "automation-probe" if "ref_prefix" in item else ref
            try:
                valid = run(["git", "check-ref-format", checked_ref]).returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                valid = False
            if not valid:
                raise ValueError("automation ref is not a valid branch or tag ref")


def snapshot_time(value: str) -> datetime:
    parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    if parsed.tzinfo is None:
        raise ValueError("snapshot/activity time needs a timezone")
    return parsed.astimezone(timezone.utc)


def github_repository(repo: str, remote: str, remote_url: str | None = None) -> tuple[str, str] | None:
    """Resolve a supported GitHub API identity; never guess for local/unknown URLs.
    Tag attribution supplies the snapshot URL, while branch activity keeps live resolution."""
    if remote_url is None:
        url = run(["git", "-C", repo, "remote", "get-url", remote])
        if url.returncode:
            return None
        remote_url = url.stdout.strip()
    raw = remote_url
    if "://" in raw:
        parsed = urlparse(raw)
        host, path = parsed.hostname, parsed.path.lstrip("/")
    else:
        match = re.fullmatch(r"(?:[^@/:]+@)?([^/:]+):(.+)", raw)
        if not match:
            return None
        host, path = match.groups()
    if host not in ({"github.com", os.environ.get("GH_HOST", "github.com")} | gh_configured_hosts()):
        return None
    path = path.removesuffix(".git")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", path):
        return None
    return host, path


def release_author(repo: str, remote: str, tag: str, remote_url: str) -> str | None:
    """Release author in the snapshotted repository, not tag/commit metadata or live remotes."""
    try:
        identity = github_repository(repo, remote, remote_url)
        if identity is None:
            return None
        host, path = identity
        result = run(["gh", "api", "--hostname", host,
                      f"repos/{path}/releases/tags/{quote(tag, safe='')}"], timeout=60)
        if result.returncode:
            return None
        release = json.loads(result.stdout)
        if release["tag_name"] != tag:
            return None
        actor = release["author"]["login"]
        return actor if isinstance(actor, str) else None
    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError, TypeError, AttributeError):
        return None


def activity_entries(repo: str, remote: str, ref: str, times: tuple[str, str]) -> list[dict] | None:
    """GitHub activity-API push records for `ref` inside the snapshot window, oldest first.
    Push records only, never commit metadata. None when the evidence is missing, unreadable
    or empty, so callers grant nothing."""
    try:
        start, end = map(snapshot_time, times)
        if start >= end:
            return None
        identity = github_repository(repo, remote)
        if identity is None:
            return None
        host, path = identity
        result = run(["gh", "api", "--hostname", host, "--paginate", "--slurp",
                      f"repos/{path}/activity?ref={quote(ref, safe='')}&per_page=100"], timeout=120)
        if result.returncode:
            return None
        pages = json.loads(result.stdout)
        if not isinstance(pages, list) or any(not isinstance(page, list) for page in pages):
            return None
        entries = []
        for page in pages:
            for entry in page:
                timestamp = snapshot_time(entry["timestamp"])
                if start <= timestamp <= end:
                    entries.append(entry)
        if not entries:
            return None
        # API is newest first. Preserve chronological order even for equal timestamps.
        entries.reverse()
        entries.sort(key=lambda entry: snapshot_time(entry["timestamp"]))
        return entries
    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError, TypeError, AttributeError):
        return None


def automation_actor(repo: str, remote: str, ref: str, old: str, new: str,
                     items: list[dict], defaults: list[str | None],
                     times: tuple[str, str]) -> str | None:
    """Require a complete chronological chain by one granted actor, never commit metadata.
    Adjacent records of the same transition at the same instant may have distinct API IDs;
    collapse only those exact duplicates, not gaps, conflicting actors or later repeats.
    Unknown or incomplete evidence fails closed.
    """
    if (not ref.startswith("refs/heads/") or ref == "refs/heads/main"
            or None in defaults or ref in defaults):
        return None
    candidates = [item["actor"] for item in items if
                  item.get("ref") == ref or
                  ("ref_prefix" in item and ref.startswith(item["ref_prefix"]))]
    if not candidates:
        return None
    entries = activity_entries(repo, remote, ref, times)
    if not entries:
        return None
    try:
        zero = "0" * 40
        expected = old or zero
        previous = None
        for entry in entries:
            if (entry["ref"] != ref or entry["actor"]["login"] not in candidates
                    or entry["actor"]["login"] != entries[0]["actor"]["login"]
                    or entry["activity_type"] not in {"push", "force_push", "branch_creation", "branch_deletion"}
                    or not re.fullmatch(r"[0-9a-f]{40}", entry["before"])
                    or not re.fullmatch(r"[0-9a-f]{40}", entry["after"])):
                return None
            transition = (entry["ref"], entry["actor"]["login"], entry["activity_type"],
                          entry["timestamp"], entry["before"], entry["after"])
            if transition == previous:
                continue
            if entry["before"] != expected:
                return None
            previous = transition
            expected = entry["after"]
        return entries[0]["actor"]["login"] if expected == (new or zero) else None
    except (KeyError, TypeError, AttributeError):
        return None


BOT_PUSH_TYPES = {"push", "force_push", "pr_merge", "merge_queue_merge"}


def bot_pushed_commits(repo: str, remote: str, ref: str, bot_logins: list[str],
                       times: tuple[str, str]) -> set[str]:
    """Commits inside a `before..after` range that a declared bot actor itself pushed or merged
    in the snapshot window, per GitHub's activity API. Commit author/committer metadata is never
    read: it is forgeable. Missing or incomplete evidence grants nothing."""
    if not bot_logins:
        return set()
    covered: set[str] = set()
    for entry in activity_entries(repo, remote, ref, times) or []:
        try:
            if (entry["ref"] != ref or entry["actor"]["login"] not in bot_logins
                    or entry["activity_type"] not in BOT_PUSH_TYPES
                    or not re.fullmatch(r"[0-9a-f]{40}", entry["before"])
                    or not re.fullmatch(r"[0-9a-f]{40}", entry["after"])
                    or entry["before"] == ZERO_SHA):
                continue
            commits = rev_list(repo, f"{entry['before']}..{entry['after']}")
        except (KeyError, TypeError):
            continue
        if commits:
            covered.update(commits)
    return covered


PROTO_MARKER = "loop-pi-proto"
ZERO_SHA = "0" * 40


def is_proto2(run_dir: str | None) -> bool:
    return bool(run_dir) and os.path.isfile(os.path.join(run_dir, PROTO_MARKER))


def load_push_log(path: str | None) -> list[dict]:
    """Well-formed push-log records; unreadable lines are skipped (they grant nothing)."""
    entries: list[dict] = []
    if not path:
        return entries
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if (isinstance(obj, dict) and isinstance(obj.get("repo"), str) and isinstance(obj.get("ref"), str)
                        and isinstance(obj.get("new"), str) and re.fullmatch(r"[0-9a-f]{40}", obj["new"])
                        and (obj.get("old") is None or (isinstance(obj["old"], str)
                                                         and re.fullmatch(r"[0-9a-f]{40}", obj["old"])))):
                    entries.append(obj)
    except OSError:
        pass
    return entries


def rev_list(repo: str, spec: str) -> list[str] | None:
    try:
        result = run(["git", "-C", repo, "rev-list", spec], timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout.split() if result.returncode == 0 else None


def repository_identity(repo: str) -> str | None:
    """The shared git directory, not a remote URL: linked worktrees are the same repository,
    but independent clones sharing a remote must never inherit each other's logged pushes."""
    try:
        result = run(["git", "-C", repo, "rev-parse", "--path-format=absolute", "--git-common-dir"])
    except (OSError, subprocess.TimeoutExpired):
        return None
    return os.path.realpath(result.stdout.strip()) if result.returncode == 0 and result.stdout.strip() else None


def logged_commits(repo: str, ref: str, push_log: list[dict]) -> set[str]:
    """Commits inside any logged `old..new` push range for this repository and ref."""
    real = os.path.realpath(repo)
    identity = repository_identity(repo)
    covered: set[str] = set()
    identities: dict[str, str | None] = {}
    for entry in push_log:
        if entry["ref"] != ref:
            continue
        logged_repo = os.path.realpath(entry["repo"])
        if logged_repo != real:
            if logged_repo not in identities:
                identities[logged_repo] = repository_identity(logged_repo)
            if identity is None or identities[logged_repo] != identity:
                continue
        commits = rev_list(repo, f"{entry['old']}..{entry['new']}" if entry.get("old") else entry["new"])
        if commits:
            covered.update(commits)
    return covered


def touches_only_backlog(repo: str, sha: str) -> bool:
    parents = run(["git", "-C", repo, "rev-list", "--parents", "-n", "1", sha]).stdout.split()[1:]
    if parents:
        cmd = ["git", "-C", repo, "diff-tree", "-r", "-z", "--name-only", "--no-commit-id", parents[0], sha]
    else:
        cmd = ["git", "-C", repo, "diff-tree", "-r", "-z", "--name-only", "--no-commit-id", "--root", sha]
    result = run(cmd)
    paths = [p for p in result.stdout.split("\0") if p]
    return result.returncode == 0 and bool(paths) and all(p.startswith("backlog/") for p in paths)


def default_move_verdict(repo: str, remote: str, ref: str, before_sha: str, after_sha: str,
                         push_log: list[dict], bot_logins: list[str],
                         times: tuple[str, str] = ("", "")) -> tuple[bool, list[str]]:
    """Protocol 2: is every commit in before..after accounted for? Returns (covered, notes)."""
    fetched, reason = fetch_ref(repo, remote, ref)
    if not fetched:
        return False, [f"cannot verify commits: {reason}"]
    commits = rev_list(repo, f"{before_sha}..{after_sha}")
    if commits is None:
        return False, [f"cannot list commits {before_sha[:12]}..{after_sha[:12]}"]
    logged = logged_commits(repo, ref, push_log)
    bot_pushed: set[str] | None = None
    notes = []
    for sha in commits:
        if sha in logged or touches_only_backlog(repo, sha):
            continue
        if bot_pushed is None:
            bot_pushed = bot_pushed_commits(repo, remote, ref, bot_logins, times)
        if sha in bot_pushed:
            continue
        notes.append(f"commit {sha[:12]} is not in a logged push, is not backlog-only and was not pushed "
                     "or merged by a declared bot actor")
    return not notes, notes


def shared_remote_grants(before_repos: dict, after_repos: dict, grants_by_repo: dict) -> dict:
    """Share only explicit remote-ref authority, identified from both snapshots."""
    shared = {}
    for name in sorted(set(before_repos) & set(after_repos)):
        grants = grants_by_repo.get(name, [])
        refs = set(grants.get("refs", [])) if isinstance(grants, dict) else set(grants)
        rewrites = set(grants.get("allow_non_fast_forward", [])) & refs if isinstance(grants, dict) else set()
        for remote, b in before_repos[name].get("remotes", {}).items():
            a = after_repos[name].get("remotes", {}).get(remote, {})
            url = b.get("url")
            if url and url == a.get("url") and b.get("available") and a.get("available"):
                authority = shared.setdefault(url, {"refs": set(), "rewrites": set()})
                authority["refs"].update(refs)
                authority["rewrites"].update(rewrites)
    return shared


def compare_repo(name: str, before: dict, after: dict, grants: list[str] | dict, report: list[str],
                 times: tuple[str, str] = ("", ""), shared: dict | None = None,
                 seen_granted: set | None = None, ops_release: bool = False,
                 proto: dict | None = None) -> bool:
    """Returns True if changes are granted or foreign automation. `proto` (protocol 2) is
    {"push_log": [...]}: default-branch moves are then judged commit by commit."""
    automation = grants.get("automation", []) if isinstance(grants, dict) else []
    bot_logins = grants.get("bot_actors", []) if isinstance(grants, dict) else []
    rewrites = set(grants.get("allow_non_fast_forward", [])) if isinstance(grants, dict) else set()
    grants = grants.get("refs", []) if isinstance(grants, dict) else grants
    all_covered = True

    before_remotes = before.get("remotes", {})
    after_remotes = after.get("remotes", {})
    release_authors: dict[tuple[str, str], str | None] = {}

    def tag_actor(ref: str, change: str, remote: str | None = None) -> str | None:
        # Release authorship proves creation, not who subsequently rewrote/deleted a tag.
        if change != "added" or not ref.startswith("refs/tags/"):
            return None
        target = ref.removesuffix("^{}")
        candidates = {item["actor"] for item in automation if item.get("ref") == target or
                      ("ref_prefix" in item and target.startswith(item["ref_prefix"]))}
        if not candidates:
            return None
        remotes = [remote] if remote is not None else sorted(set(before_remotes) & set(after_remotes))
        for source in remotes:
            b, a = before_remotes.get(source, {}), after_remotes.get(source, {})
            if (not b.get("available") or not a.get("available") or not isinstance(b.get("url"), str)
                    or not b["url"] or b["url"] != a.get("url")):
                continue
            tag = target[len("refs/tags/"):]
            key = (source, tag)
            if key not in release_authors:
                release_authors[key] = release_author(name, source, tag, b["url"])
            actor = release_authors[key]
            if actor in candidates:
                return actor
        return None

    for remote in sorted(set(before_remotes) | set(after_remotes)):
        b = before_remotes.get(remote, {"available": False, "reason": "remote absent before"})
        a = after_remotes.get(remote, {"available": False, "reason": "remote absent after"})
        if not b.get("available") or not a.get("available"):
            report.append(
                f"[{name}] remote '{remote}': ls-remote unavailable on one side "
                f"(before={b.get('reason', 'ok')!r}, after={a.get('reason', 'ok')!r}); UNVERIFIED - cannot "
                f"confirm no ungranted change occurred."
            )
            all_covered = False
            continue
        url = b.get("url") if b.get("url") == a.get("url") else None
        authority = (shared or {}).get(url, {})
        remote_grants = authority.get("refs", grants)
        remote_rewrites = authority.get("rewrites", rewrites)
        defaults: set[str] = set()
        verdicts: dict[str, tuple[bool, list[str]]] = {}
        if proto is not None:
            defaults = {t for t in (head_target(b, a), head_target(a, b)) if t}
            if not defaults:
                defaults = {"refs/heads/main", "refs/heads/master"}
            for ref in sorted(set(remote_grants) & defaults):
                print(f"loop-pi-audit: warning: grant for {ref} on {name} ignored; protocol 2 never grants the "
                      "default branch by ref", file=sys.stderr)
            remote_grants = set(remote_grants) - defaults
            remote_rewrites = set(remote_rewrites) - defaults

        def default_verdict(ref: str) -> tuple[bool, list[str]]:
            if ref not in verdicts:
                before_sha, after_sha = b.get("refs", {}).get(ref), a.get("refs", {}).get(ref)
                if before_sha and after_sha and before_sha != after_sha:
                    verdicts[ref] = default_move_verdict(name, remote, ref, before_sha, after_sha,
                                                         proto["push_log"], bot_logins, times)
                else:
                    verdicts[ref] = (False, [])
            return verdicts[ref]
        changes = diff_ref_map(b.get("refs", {}), a.get("refs", {}))
        before_head = b.get("symrefs", {}).get("HEAD")
        after_head = a.get("symrefs", {}).get("HEAD")
        # Missing metadata in a legacy snapshot is not itself a retargeting.
        if (before_head and after_head and before_head != after_head
                and not any(ref == "HEAD" for _, ref, _, _ in changes)):
            changes.append(("retargeted", "HEAD", b.get("refs", {}).get("HEAD", ""),
                            a.get("refs", {}).get("HEAD", "")))
        for change, ref, before_sha, after_sha in changes:
            target = ref
            notes: list[str] = []
            actor = tag_actor(ref, change, remote) or automation_actor(
                name, remote, ref, before_sha, after_sha, automation,
                [head_target(b, a), head_target(a, b)], times)
            if actor:
                report.append(f"[{name}] remote '{remote}' ref {change}: {ref} "
                              f"({before_sha or '-'} -> {after_sha or '-'}) [automation actor={actor}]")
                continue
            if ref == "HEAD":
                targets = [head_target(entry, other) for entry, other, sha in
                           ((b, a, before_sha), (a, b, after_sha)) if sha]
                if not targets or any(t is None for t in targets):
                    mark = "UNVERIFIED HEAD target"
                    all_covered = False
                else:
                    covered = all(default_verdict(t)[0] if (proto is not None and t in defaults) else t in remote_grants
                                  for t in targets)
                    mark = "GRANTED derived HEAD" if covered else "UNGRANTED derived HEAD"
                    all_covered = all_covered and covered
            elif ref.startswith("refs/pull/") and ref not in remote_grants:
                mark = "FOREIGN"
            else:
                if ref.startswith("refs/tags/") and ref.endswith("^{}"):
                    target = ref[:-3]
                covered = target in remote_grants
                if proto is not None and change == "moved" and ref in defaults:
                    covered, notes = default_verdict(ref)
                if (not covered and ops_release and change == "added" and ref.startswith("refs/tags/")):
                    report.append(f"[{name}] remote '{remote}' ref {change}: {ref} "
                                  f"({before_sha[:12] or '-'} -> {after_sha[:12] or '-'}) [GRANTED ops release]")
                    continue
                if change == "moved" and ref == target:
                    mark, contributes_covered = moved_ref_mark(
                        name, remote, ref, before_sha, after_sha, covered,
                        ref.startswith("refs/heads/") and ref in remote_rewrites and ref not in defaults)
                    all_covered = all_covered and contributes_covered
                else:
                    all_covered = all_covered and covered
                    mark = "GRANTED" if covered else "UNGRANTED"
            # Deduplicate only verified granted outcomes, never violations or unknowns.
            head_identity = (before_head, after_head) if ref == "HEAD" else ()
            key = (url, change, ref, before_sha, after_sha, head_identity, mark)
            if url and mark.startswith("GRANTED") and seen_granted is not None:
                if key in seen_granted:
                    continue
                seen_granted.add(key)
            report.append(f"[{name}] remote '{remote}' ref {change}: {ref} ({before_sha[:12] or '-'} -> {after_sha[:12] or '-'}) [{mark}]")
            for note in notes:
                report.append(f"[{name}] remote '{remote}' ref {change}: {ref} note: {note}")

    before_tags = before.get("tags", {})
    after_tags = after.get("tags", {})
    if not before_tags.get("available") or not after_tags.get("available"):
        report.append(
            f"[{name}] local tags: unavailable on one side "
            f"(before={before_tags.get('reason', 'ok')!r}, after={after_tags.get('reason', 'ok')!r}); UNVERIFIED - "
            f"cannot confirm no ungranted change occurred."
        )
        all_covered = False
    else:
        for change, ref, before_sha, after_sha in diff_ref_map(before_tags.get("tags", {}), after_tags.get("tags", {})):
            actor = tag_actor(ref, change)
            if actor:
                report.append(f"[{name}] tag {change}: {ref} ({before_sha[:12] or '-'} -> {after_sha[:12] or '-'}) "
                              f"[automation actor={actor}]")
                continue
            covered = ref in grants
            if not covered and ops_release and change == "added":
                report.append(f"[{name}] tag {change}: {ref} ({before_sha[:12] or '-'} -> {after_sha[:12] or '-'}) "
                              f"[GRANTED ops release]")
                continue
            all_covered = all_covered and covered
            mark = "GRANTED" if covered else "UNGRANTED"
            report.append(f"[{name}] tag {change}: {ref} ({before_sha[:12] or '-'} -> {after_sha[:12] or '-'}) [{mark}]")

    before_releases = before.get("releases", {})
    after_releases = after.get("releases", {})
    if not before_releases.get("available") or not after_releases.get("available"):
        report.append(
            f"[{name}] releases: unavailable on one side "
            f"(before={before_releases.get('reason', 'ok')!r}, after={after_releases.get('reason', 'ok')!r}); "
            f"UNVERIFIED - cannot confirm no ungranted change occurred."
        )
        all_covered = False
    else:
        before_tags_set = {r["tagName"] for r in before_releases.get("releases", []) if "tagName" in r}
        after_tags_set = {r["tagName"] for r in after_releases.get("releases", []) if "tagName" in r}
        for tag in sorted(after_tags_set - before_tags_set):
            actor = tag_actor(f"refs/tags/{tag}", "added")
            if actor:
                report.append(f"[{name}] release added: {tag} [automation actor={actor}]")
                continue
            covered = tag in grants or f"refs/tags/{tag}" in grants
            if not covered and ops_release:
                report.append(f"[{name}] release added: {tag} [GRANTED ops release]")
                continue
            all_covered = all_covered and covered
            mark = "GRANTED" if covered else "UNGRANTED"
            report.append(f"[{name}] release added: {tag} [{mark}]")
        for tag in sorted(before_tags_set - after_tags_set):
            covered = tag in grants or f"refs/tags/{tag}" in grants
            all_covered = all_covered and covered
            mark = "GRANTED" if covered else "UNGRANTED"
            report.append(f"[{name}] release removed: {tag} [{mark}]")

    return all_covered


def cmd_compare(args: argparse.Namespace) -> int:
    with open(args.before, "r", encoding="utf-8") as fh:
        before = json.load(fh)
    with open(args.after, "r", encoding="utf-8") as fh:
        after = json.load(fh)

    run_dir = getattr(args, "run_dir", None)
    proto_run = (is_proto2(run_dir) or before.get("protocol") == 2 or after.get("protocol") == 2
                 or getattr(args, "push_log", None) is not None)
    grants_sha256 = getattr(args, "grants_sha256", None)
    grants_by_repo: dict[str, list[str]] = {}
    if grants_sha256 is not None and not args.grants:
        print("loop-pi-audit: invalid grants: --grants-sha256 needs --grants", file=sys.stderr)
        return 2
    if args.grants:
        with open(args.grants, "rb") as fh:
            raw_grants = fh.read()
        if grants_sha256 is not None:
            actual = hashlib.sha256(raw_grants).hexdigest()
            if actual != grants_sha256.strip().lower():
                print(f"loop-pi-audit: invalid grants: {args.grants} has sha256 {actual}, which does not match "
                      f"--grants-sha256 {grants_sha256}", file=sys.stderr)
                return 2
        elif proto_run:
            print(f"loop-pi-audit: warning: grants file {args.grants} is unverified; pass --grants-sha256 with "
                  "the sha256 the launch froze for it.", file=sys.stderr)
        grants_by_repo = json.loads(raw_grants.decode("utf-8"))
    proto = None
    if proto_run:
        log_path = getattr(args, "push_log", None) or (os.path.join(run_dir, "push-log.jsonl") if run_dir else None)
        if not log_path or not os.path.isfile(log_path):
            print(f"loop-pi-audit: warning: no push log at {log_path}; default-branch moves are granted only by "
                  "backlog-only or declared bot commits.", file=sys.stderr)
        proto = {"push_log": load_push_log(log_path)}

    try:
        validate_automation(grants_by_repo)
    except (ValueError, AttributeError) as exc:
        print(f"loop-pi-audit: invalid grants: {exc}", file=sys.stderr)
        return 2
    try:
        ops_release_repos = load_ops_release(getattr(args, "ops", None), getattr(args, "ops_sha256", None))
    except (OSError, ValueError) as exc:
        print(f"loop-pi-audit: invalid ops file: {exc}", file=sys.stderr)
        return 2

    before_repos = before.get("repos", {})
    after_repos = after.get("repos", {})
    all_names = sorted(set(before_repos) | set(after_repos))

    shared = shared_remote_grants(before_repos, after_repos, grants_by_repo)
    seen_granted: set = set()
    report: list[str] = []
    all_ok = True
    any_change = False
    for name in all_names:
        if name not in before_repos or name not in after_repos:
            # A repo dropped from one snapshot entirely (a crashed run, a
            # wrong repo list, ...) can't be diffed at all, so it must never
            # be silently treated as "no remotes, nothing to check" - that
            # would hide every change made to it.
            missing_from = "before" if name not in before_repos else "after"
            report.append(f"[{name}] repository missing from the {missing_from} snapshot; UNVERIFIED - cannot confirm no ungranted change occurred.")
            all_ok = False
            any_change = True
            continue
        b = before_repos[name]
        a = after_repos[name]
        pre_len = len(report)
        covered = compare_repo(name, b, a, grants_by_repo.get(name, []), report,
                               (before.get("taken_at", ""), after.get("taken_at", "")), shared, seen_granted,
                               os.path.realpath(name) in ops_release_repos, proto)
        if len(report) > pre_len:
            any_change = True
        all_ok = all_ok and covered

    if not any_change:
        print("loop-pi-audit: no remote changes detected.")
        return 0

    for line in report:
        print(line)

    if not all_ok:
        print("loop-pi-audit: at least one ungranted remote change was found.", file=sys.stderr)
        return 1
    print("loop-pi-audit: every remote change is covered by a grant.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    snap = sub.add_parser("snapshot", help="Record remote state for one or more repositories.")
    snap.add_argument("--out", required=True, help="Path to write the snapshot JSON.")
    snap.add_argument("repos", nargs="+", help="Repository paths to snapshot.")
    snap.set_defaults(func=cmd_snapshot)

    comp = sub.add_parser("compare", help="Compare two snapshots and report ungranted changes.")
    comp.add_argument("before", help="Path to the before snapshot JSON.")
    comp.add_argument("after", help="Path to the after snapshot JSON.")
    comp.add_argument("--grants", help="Path to a grants JSON file: {\"<repo>\": [\"refs/heads/main\", ...]}.")
    comp.add_argument("--ops", help="Path to the loop's frozen ops grant file; a release-kind entry covers added tags and releases in the repo holding it.")
    comp.add_argument("--ops-sha256", help=OPS_SHA256_HELP)
    comp.add_argument("--grants-sha256", help=GRANTS_SHA256_HELP)
    comp.add_argument("--push-log", help=PUSH_LOG_HELP)
    comp.add_argument("--run-dir", help="Run directory; protocol 2 rules apply when it holds loop-pi-proto "
                                        "(compare never reads $LOOP_PI_RUN_DIR).")
    comp.set_defaults(func=cmd_compare)

    for name, func, text in (("begin", cmd_begin, "Start a run's before-snapshot with REPO."),
                             ("add", cmd_add, "Add REPO to a run's before-snapshot.")):
        p = sub.add_parser(name, help=text)
        p.add_argument("--run-dir", help="Run directory (default: $LOOP_PI_RUN_DIR).")
        p.add_argument("repo")
        p.set_defaults(func=func)

    retain = sub.add_parser("retain-protocol", help="Retain the armed protocol in an existing before-snapshot without resnapshotting.")
    retain.add_argument("--run-dir", help="Run directory (default: $LOOP_PI_RUN_DIR).")
    retain.set_defaults(func=cmd_retain_protocol)

    close = sub.add_parser("closeout", help="Snapshot the run's repos again and compare.")
    close.add_argument("--run-dir", help="Run directory (default: $LOOP_PI_RUN_DIR).")
    close.add_argument("--grants", help="Path to a grants JSON file, keyed by the repo paths in the run.")
    close.add_argument("--ops", help="Path to the loop's frozen ops grant file; a release-kind entry covers added tags and releases in the repo holding it.")
    close.add_argument("--ops-sha256", help=OPS_SHA256_HELP)
    close.add_argument("--grants-sha256", help=GRANTS_SHA256_HELP)
    close.add_argument("--push-log", help=PUSH_LOG_HELP)
    close.set_defaults(func=cmd_closeout)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
