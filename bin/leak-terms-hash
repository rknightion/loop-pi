#!/usr/bin/env python3
"""Turn a plain term list into the form safe to store as a CI secret.

Reads `label<TAB>lit:<literal>` / `label<TAB>re:<regex>` lines (and `#` comments) from a file or
stdin. Writes each `lit:` line as `label<TAB>h:<salt>:<sha256(salt ":" normalised)>` and passes
`re:` and existing `h:` lines through unchanged. Comments and blank lines are dropped. The
normalisation and the findability rule are imported from bin/leak-scan, so the two never drift.

    bin/leak-terms-hash [--salt S] [FILE] > hashed.txt

Exit 2 on a malformed line or a literal leak-scan could never find; the message names the line
number only, never its text.
"""
from __future__ import annotations

# python-floor: begin (identical in every bin entry point except leak-scan; bin/test_python_floor.py pins it)
import sys

if __name__ == "__main__" and sys.version_info < (3, 15):
    import os
    import subprocess

    def _on_path(name):
        # Absolute PATH entries only: "." or an empty entry would run a file from the caller's directory.
        for directory in os.environ.get("PATH", "").split(os.pathsep):
            path = os.path.join(directory, name)
            if os.path.isabs(directory) and os.path.isfile(path) and os.access(path, os.X_OK):
                return path
        return None

    def _uv_python(uv, args, capture):
        # uv only resolves an interpreter, from "/" with --directory, its environment and config cleared, so a
        # project, .venv, VIRTUAL_ENV, UV_WORKING_DIR or uv.toml in the caller's directory is never consulted.
        try:
            done = subprocess.run([uv, "--directory", "/", "python", *args], cwd="/",
                                  env=dict(os.environ, VIRTUAL_ENV="", CONDA_PREFIX=""), stdin=subprocess.DEVNULL,
                                  stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL if capture else None, text=True)
        except OSError:
            return None
        found = done.stdout.strip() if capture and done.returncode == 0 else ""
        if (os.path.isabs(found) and os.path.isfile(found) and os.access(found, os.X_OK)
                and ".venv" not in found.split(os.sep) and ".venv" not in os.path.realpath(found).split(os.sep)):
            return found
        return None

    _python = _on_path("python3.15")
    for _path in ("/opt/homebrew/bin/python3.15", "/home/linuxbrew/.linuxbrew/bin/python3.15"):
        if not _python and os.path.isfile(_path) and os.access(_path, os.X_OK):
            _python = _path
    _uv = _on_path("uv")
    if not _python and _uv:
        _find = ["find", "--no-project", "--no-config", "--no-python-downloads", "3.15"]
        _python = _uv_python(_uv, _find, True)
        if not _python:
            _uv_python(_uv, ["install", "--no-config", "3.15"], False)
            _python = _uv_python(_uv, _find, True)
    if not _python:
        sys.exit(os.path.basename(sys.argv[0]) + " needs Python 3.15 or later and found " + sys.version.split()[0]
                 + ". Install it (macOS: brew install python@3.15; elsewhere: uv python install 3.15) and run again.")
    os.execv(_python, [_python] + sys.argv)
# python-floor: end

import argparse
import importlib.machinery
import importlib.util
import secrets
import sys
from pathlib import Path


def _scanner():
    loader = importlib.machinery.SourceFileLoader("leak_scan", str(Path(__file__).resolve().parent / "leak-scan"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def convert(text: str, salt: str, scan) -> list[str]:
    out = []
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip().strip("\r")
        if not line or line.startswith("#"):
            continue
        if "\t" not in line:
            raise ValueError(f"line {number}: expected label<TAB>pattern")
        label, pattern = (part.strip() for part in line.split("\t", 1))
        if not label or not pattern:
            raise ValueError(f"line {number}: empty label or pattern")
        if pattern.startswith("lit:"):
            if not scan.literal_findable(pattern[4:]):
                raise ValueError(f"line {number}: literal is empty or longer than {scan.MAX_NGRAM} tokens; "
                                 "use a re: line instead")
            out.append(f"{label}\th:{salt}:{scan.term_hash(salt, scan.normalise_literal(pattern[4:]))}")
        elif pattern.startswith(("re:", "h:")):
            out.append(f"{label}\t{pattern}")
        else:
            raise ValueError(f"line {number}: unknown pattern kind (expected lit:, re: or h:)")
    if not out:
        raise ValueError("no terms")
    # Check the result parses exactly as leak-scan will parse it.
    scan.Terms().add_lines("\n".join(out), "output")
    return out


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("file", nargs="?", type=Path, help="plain list (default: stdin)")
    parser.add_argument("--salt", help="salt (default: 16 random hex bytes); [A-Za-z0-9] only")
    args = parser.parse_args(argv)
    salt = args.salt or secrets.token_hex(16)
    if not salt.isalnum() or not salt.isascii():
        print("leak-terms-hash: salt must be ASCII letters and digits", file=sys.stderr)
        return 2
    try:
        text = args.file.read_text(encoding="utf-8") if args.file else sys.stdin.read()
        scan = _scanner()
        lines = convert(text, salt, scan)
    except (OSError, ValueError) as error:
        print(f"leak-terms-hash: {error}", file=sys.stderr)
        return 2
    except Exception as error:  # the scanner's ScanError, or anything else: never echo input
        print(f"leak-terms-hash: failed ({type(error).__name__})", file=sys.stderr)
        return 2
    sys.stdout.write("\n".join(lines) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
