#!/usr/bin/env python3
"""loop-state: append-only event log for a fan-out loop, with a recovery digest.

  loop-state append <log> <ev> [k=v ...] [--by root|dispatcher|ext|daemon] [--run-dir DIR]
  loop-state append <log> [--by ...] [--run-dir DIR] < event.json
  loop-state digest <log> [--json]
  loop-state check <log>

Stdlib only; runs under Python 3.9 (macOS /usr/bin/python3).

Run dir (`--run-dir DIR` on append, else $LOOP_PI_RUN_DIR; a $LOOP_PI_RUN_DIR that holds
`loop-pi-proto` wins over a different `--run-dir`, with a warning): when it holds `loop-pi-proto`, a
`close reason=budget` needs a `compaction-failed` or `quota-exhausted` fact in its
`harness-facts.jsonl`. Without the marker nothing about the run dir changes any verdict.

Exit codes: 0 ok; 2 append rejected (validation error, a second `open`, a pre-green land or an
unlicensed budget close) or usage error;
1 digest/check failure (unreadable log, or the first invalid line for `check`).
"""
from __future__ import annotations

import fcntl
import json
import os
import re
import sys
from datetime import datetime, timezone

VERSION = 1
GATE_AGENT = "gate-runner"
# The agents bound to one ops surface; their dispatches should name it.
OPS_AGENTS = ("ops", "ops-probe")
DIGEST_MAX_BYTES = 4096
JUDGEMENT_MAX_BYTES = 4096
JUDGEMENTS_IN_DIGEST = 5
BY_VALUES = ("root", "dispatcher", "ext", "daemon")
TS_RE = re.compile(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$")

STR = "str"
STR_OR_NULL = "str?"
INT = "int"
INT_OR_NULL = "int?"
BOOL = "bool"
STRLIST = "strlist"
OWNED = "owned"
CODERABBIT = "coderabbit"

STATUS = ("complete", "partial", "blocked", "failed")
TIER = ("routine", "guarded")

# ev -> (required {field: type}, optional {field: type}); a tuple type is an enum of strings.
SCHEMA = {
    "open": (
        {
            "goal_sha256": STR,
            "tier": TIER,
            "root": ("llm", "dispatcher"),
            "root_model": STR,
            "envelope": STRLIST,
        },
        {},
    ),
    "admit": (
        {"task": STR, "source": ("envelope", "loop-created"), "owned": OWNED, "accept": STR},
        {"tier": TIER, "surfaces": STRLIST},
    ),
    "dispatch": (
        {"lane": STR, "task": STR, "agent": STR, "run": STR, "base": STR},
        {"deadline": STR, "model": STR, "effort": STR, "surface": STR,
         "tier": TIER, "tasks": STRLIST, "kind": ("work", "gate", "triage", "review"),
         "recovery_of": STR},
    ),
    "return": (
        {"lane": STR, "run": STR, "status": STATUS},
        {
            "sha": STR_OR_NULL,
            "landed": BOOL,
            "check": STR,
            "exit": INT_OR_NULL,
            "ci": STR_OR_NULL,
            "coderabbit": CODERABBIT,
            "base": STR,
            "questions": STRLIST,
        },
    ),
    "gate": (
        {"scope": ("lane", "composed"), "sha": STR, "cmd": STR, "exit": INT_OR_NULL},
        {"lane": STR, "base": STR},
    ),
    "accept": ({"task": STR, "accepted": BOOL, "reason": STR}, {"lane": STR}),
    "park": (
        {
            "task": STR,
            "reason": STR,
            "needs": ("owner", "authority", "evidence-later", "dependency", "defect", "budget"),
        },
        {"lane": STR, "until": STR},
    ),
    "land": (
        {"task": STR, "sha": STR, "gate": STR, "mode": ("after-green", "pre-green")},
        {"lane": STR, "ci": STR},
    ),
    "revert": (
        {
            "sha": STR,
            "reverted_by": STR,
            # ci-red, ci-timeout and composed-red are the retired daemon's reasons: kept so legacy
            # logs still validate.
            "reason": ("ci-red", "ci-timeout", "composed-red", "root-decision"),
        },
        {"task": STR},
    ),
    "watch": ({"op": ("start", "stop"), "what": STR, "deadline": STR}, {}),
    "heartbeat": ({"at": STR}, {}),
    "judgement": ({"text": STR}, {"task": STR, "lane": STR}),
    "close": (
        {"reason": ("nothing-admissible", "owner-stop", "blocked", "budget")},
        {},
    ),
}


PRE_GREEN_REFUSAL = "lands-pre-green was removed; land after green"
BUDGET_REFUSAL = (
    "close budget refused: the harness compacts automatically. Budget needs a recorded quota or "
    "compaction failure; continue the next admissible task."
)
BUDGET_FACT_KINDS = ("compaction-failed", "quota-exhausted")


class Rejected(Exception):
    """An event or an append that must be refused (exit 2 on append)."""


def _is_int(v):
    return isinstance(v, int) and not isinstance(v, bool)


def _check_value(field, kind, value):
    """Return None when value fits kind, else a message."""
    if isinstance(kind, tuple):
        if not isinstance(value, str) or value not in kind:
            return "%s must be one of %s" % (field, "|".join(kind))
        return None
    if kind == STR:
        if not isinstance(value, str) or value == "":
            return "%s must be a non-empty string" % field
    elif kind == STR_OR_NULL:
        if value is not None and (not isinstance(value, str) or value == ""):
            return "%s must be a non-empty string or null" % field
    elif kind == INT:
        if not _is_int(value):
            return "%s must be an integer" % field
    elif kind == INT_OR_NULL:
        if value is not None and not _is_int(value):
            return "%s must be an integer or null" % field
    elif kind == BOOL:
        if not isinstance(value, bool):
            return "%s must be true or false" % field
    elif kind == STRLIST:
        if not isinstance(value, list) or not all(isinstance(x, str) for x in value):
            return "%s must be a list of strings" % field
    elif kind == OWNED:
        ok = isinstance(value, str) and value != ""
        ok = ok or (isinstance(value, list) and all(isinstance(x, str) for x in value))
        if not ok:
            return "%s must be a string or a list of strings" % field
    elif kind == CODERABBIT:
        if value is None:
            return None
        if (
            not isinstance(value, dict)
            or not isinstance(value.get("ran"), bool)
            or not _is_int(value.get("major"))
            or not _is_int(value.get("unreviewed"))
        ):
            return "%s must be null or {ran:bool, major:int, unreviewed:int}" % field
    return None


def validate_event(obj, framed=False):
    """Validate an event body. framed=True also checks v, seq, ts and by (used by `check`, which
    must keep accepting legacy `land mode=pre-green` lines)."""
    if not isinstance(obj, dict):
        raise Rejected("event must be a JSON object")
    ev = obj.get("ev")
    if not isinstance(ev, str) or ev not in SCHEMA:
        raise Rejected("ev must be one of %s" % "|".join(SCHEMA))
    required, optional = SCHEMA[ev]
    envelope = {"ev", "v", "seq", "ts", "by"}
    for field in obj:
        if field not in required and field not in optional and field not in envelope:
            raise Rejected(
                "%s: unknown field %s; allowed fields: %s"
                % (ev, field, ", ".join(list(required) + list(optional)))
            )
    for field, kind in required.items():
        if field not in obj:
            raise Rejected("%s: missing required field %s" % (ev, field))
        msg = _check_value(field, kind, obj[field])
        if msg:
            raise Rejected("%s: %s" % (ev, msg))
    for field, kind in optional.items():
        if field in obj:
            msg = _check_value(field, kind, obj[field])
            if msg:
                raise Rejected("%s: %s" % (ev, msg))
    if ev == "heartbeat":
        activity_at(obj["at"])
    if ev == "judgement" and len(obj["text"].encode("utf-8")) > JUDGEMENT_MAX_BYTES:
        raise Rejected("judgement: text is over %d bytes" % JUDGEMENT_MAX_BYTES)
    if framed:
        if obj.get("v") != VERSION or not _is_int(obj.get("v")):
            raise Rejected("v must be %d" % VERSION)
        if not _is_int(obj.get("seq")) or obj["seq"] < 1:
            raise Rejected("seq must be a positive integer")
        if not isinstance(obj.get("ts"), str) or not TS_RE.match(obj["ts"]):
            raise Rejected("ts must be an ISO UTC timestamp ending in Z")
        if obj.get("by") not in BY_VALUES:
            raise Rejected("by must be one of %s" % "|".join(BY_VALUES))
    elif "by" in obj and obj["by"] not in BY_VALUES:
        raise Rejected("by must be one of %s" % "|".join(BY_VALUES))


def _field_kind(ev, field):
    required, optional = SCHEMA[ev]
    return required.get(field, optional.get(field))


def parse_kv(ev, pairs):
    """Turn k=v tokens into a dict. Values are JSON-parsed when they parse; a string-typed
    field keeps its raw text unless it is a JSON string literal, so a numeric-looking run id or
    SHA stays a string."""
    out = {"ev": ev}
    for token in pairs:
        if "=" not in token:
            raise Rejected("expected k=v, got %r" % token)
        key, raw = token.split("=", 1)
        if not key:
            raise Rejected("empty key in %r" % token)
        if key == "by":
            raise Rejected("by is not a k=v field; use --by")
        if key in ("v", "seq", "ts", "ev"):
            raise Rejected("%s is set by loop-state" % key)
        if key in out:
            raise Rejected("duplicate field %s" % key)
        kind = _field_kind(ev, key) if ev in SCHEMA else None
        try:
            parsed = json.loads(raw)
            parsed_ok = True
        except ValueError:
            parsed, parsed_ok = raw, False
        if kind == STRLIST:
            if parsed_ok and isinstance(parsed, list):
                out[key] = parsed
            elif raw.lstrip().startswith("["):
                out[key] = raw  # broken JSON: let validation name the field
            else:
                out[key] = [part.strip() for part in raw.split(",") if part.strip()]
        elif kind in (STR, STR_OR_NULL) or isinstance(kind, tuple):
            if parsed_ok and (isinstance(parsed, str) or (parsed is None and kind == STR_OR_NULL)):
                out[key] = parsed
            else:
                out[key] = raw
        else:
            out[key] = parsed
    return out


def activity_at(at):
    """UTC event time with optional subsecond precision; unlike framing ts, at keeps milliseconds."""
    if not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,6})?Z", at):
        raise Rejected("heartbeat: at must be an ISO UTC timestamp ending in Z")
    try:
        return datetime.fromisoformat(at[:-1] + "+00:00")
    except ValueError:
        raise Rejected("heartbeat: at must be a valid ISO UTC timestamp")


def replayed_activity(data, event):
    """Under the append lock, suppress exact watch replay and heartbeat intervals below 300s.
    The log, not the process lifetime or session branch, owns this deduplication."""
    if event["ev"] not in ("watch", "heartbeat"):
        return None
    for raw in reversed(data.split(b"\n")):
        try:
            previous = json.loads(raw)
            validate_event(previous, framed=True)
        except (ValueError, Rejected):
            continue
        if previous["ev"] != event["ev"]:
            continue
        if event["ev"] == "watch":
            if all(previous.get(k) == event[k] for k in ("op", "what", "deadline")):
                return previous
        elif (activity_at(event["at"]) - activity_at(previous["at"])).total_seconds() < 300:
            return previous
        else:
            return None
    return None


def utc_now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _event_seq(raw):
    """The integer seq of one complete log line, else None."""
    try:
        obj = json.loads(raw.decode("utf-8"))
    except ValueError:
        return None
    seq = obj.get("seq") if isinstance(obj, dict) else None
    return seq if _is_int(seq) else None


def _is_torn(raw):
    """A partial write of an event: the start of a JSON object that does not parse."""
    if not raw.lstrip().startswith(b"{"):
        return False
    try:
        json.loads(raw.decode("utf-8"))
    except ValueError:
        return True
    return False


def _tail_state(data):
    """(last seq, prefix) for an append to a log holding `data`. The prefix is written before the
    new event and is a newline when the log does not end with one.

    The writer puts each event and its newline down in one write under the lock, so a last line
    with no newline is a write that was cut short. When it parses with an integer seq it is a
    complete event that lost only its newline: it is kept and the seq continues from it. When it
    is torn (the start of an event that does not parse) it held no complete event: the new event
    starts on a fresh line, the torn bytes stay where they are, and reads skip them. Anything else
    is refused."""
    if not data:
        return 0, b""
    prefix = b""
    lines = data.split(b"\n")
    if not data.endswith(b"\n"):
        tail = lines.pop()
        seq = _event_seq(tail)
        if seq is not None:
            return seq, b"\n"
        if not _is_torn(tail):
            raise Rejected(
                "the log's last line is not an event and has no newline; repair it by moving that "
                "line out of the log (`loop-state check <log>` names it), then append again"
            )
        sys.stderr.write(
            "loop-state: skipped a torn last line (%d bytes, a cut-short write); "
            "the event starts on a fresh line\n" % len(tail)
        )
        prefix = b"\n"
    for raw in reversed(lines):
        if not raw.strip():
            continue
        seq = _event_seq(raw)
        if seq is not None:
            return seq, prefix
        if _is_torn(raw):
            continue
        raise Rejected(
            "the log's last line is not a valid event; repair it by moving that line out of the log "
            "(`loop-state check <log>` names it), then append again"
        )
    return 0, prefix


def read_run_facts(run_dir):
    """The `kind` of every readable fact in `<run_dir>/harness-facts.jsonl` (none when absent)."""
    kinds = []
    try:
        with open(os.path.join(run_dir, "harness-facts.jsonl"), encoding="utf-8") as fh:
            for line in fh:
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if isinstance(obj, dict) and isinstance(obj.get("kind"), str):
                    kinds.append(obj["kind"])
    except OSError:
        pass
    return kinds


def check_budget_close(run_dir):
    """Refuse `close reason=budget` in a protocol-2 run that holds no compaction or quota fact."""
    if not run_dir or not os.path.isfile(os.path.join(run_dir, "loop-pi-proto")):
        return
    if not any(k in BUDGET_FACT_KINDS for k in read_run_facts(run_dir)):
        raise Rejected(BUDGET_REFUSAL)


def do_append(log_path, event, by, run_dir=None):
    validate_event(event)
    event = dict(event)
    if event["ev"] == "land" and event["mode"] == "pre-green":
        raise Rejected(PRE_GREEN_REFUSAL)
    if event["ev"] == "close" and event["reason"] == "budget":
        check_budget_close(run_dir)
    by = by or event.get("by") or "root"
    if by not in BY_VALUES:
        raise Rejected("by must be one of %s" % "|".join(BY_VALUES))
    parent = os.path.dirname(os.path.abspath(log_path))
    os.makedirs(parent, exist_ok=True)
    fd = os.open(log_path, os.O_RDWR | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        size = os.fstat(fd).st_size
        data = os.pread(fd, size, 0) if size else b""
        while len(data) < size:
            more = os.pread(fd, size - len(data), len(data))
            if not more:
                break
            data += more
        last, prefix = _tail_state(data)
        if event["ev"] == "open" and _log_has_open(data):
            raise Rejected("open refused: the log already has an open event; a loop opens once")
        replay = replayed_activity(data, event)
        if replay is not None:
            return replay
        seq = last + 1
        framed = {"v": VERSION, "seq": seq, "ts": utc_now(), "ev": event["ev"], "by": by}
        for key, value in event.items():
            if key not in framed:
                framed[key] = value
        line = prefix + (json.dumps(framed, separators=(",", ":"), ensure_ascii=False) + "\n").encode("utf-8")
        view = memoryview(line)
        while view:
            written = os.write(fd, view)
            view = view[written:]
        os.fsync(fd)
    finally:
        os.close(fd)  # closing releases the flock
    return framed


def _log_has_open(data):
    for raw in data.split(b"\n"):
        if b'"open"' not in raw:
            continue
        try:
            obj = json.loads(raw.decode("utf-8"))
        except ValueError:
            continue
        if isinstance(obj, dict) and obj.get("ev") == "open":
            return True
    return False


TORN = "torn"


def read_events(path, strict):
    """Yield (lineno, event_or_None, error_or_None) for each non-empty line. A torn line (a write
    cut short, see `_tail_state`) yields the error TORN."""
    with open(path, "rb") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_SH)
        data = fh.read()
    for lineno, raw in enumerate(data.split(b"\n"), 1):
        if not raw.strip():
            continue
        if _is_torn(raw):
            yield lineno, None, TORN
            continue
        try:
            obj = json.loads(raw.decode("utf-8"))
        except ValueError as exc:
            yield lineno, None, "not valid JSON (%s)" % exc
            continue
        yield lineno, obj, None


def do_check(path):
    """The first problem in the log, or None. A torn line is skipped: it held no complete event,
    and the seq check on the lines around it proves that no event was lost with it."""
    prev = 0
    for lineno, obj, err in read_events(path, True):
        if err == TORN:
            sys.stderr.write("loop-state: %s: line %d: skipped a torn line (a cut-short write)\n" % (path, lineno))
            continue
        if err is None:
            try:
                validate_event(obj, framed=True)
                if obj["seq"] != prev + 1:
                    raise Rejected("seq %s follows %s; expected %d" % (obj["seq"], prev, prev + 1))
            except Rejected as exc:
                err = str(exc)
        if err is not None:
            return "%s: line %d: %s" % (path, lineno, err)
        prev = obj["seq"]
    return None


# ---------------------------------------------------------------------------- digest


def fold(path):
    """Fold the log into a plain state dict. Tolerant: lines that do not parse are counted."""
    st = {
        "open": None,
        "close": None,
        "tasks": {},
        "order": [],
        "lanes": {},  # run -> {lane, task, agent, deadline}
        "audit_lanes": {},  # dispatch metadata retained after return
        "dispatches": {},  # run -> original dispatch, even after lane reuse
        "returns": {},  # first terminal outcome per run; replays are not new work
        "lane_task": {},  # lane -> task
        "judgements": [],
        "last_gate": None,
        "heartbeat": None,
        "watches": {},
        "has_activity": False,
        "last_seq": 0,
        "bad": 0,
    }

    def task(tid):
        if tid not in st["tasks"]:
            st["tasks"][tid] = {
                "id": tid,
                "state": "admitted",
                "dispatched": False,
                "accepted": False,
                "landed": False,
                "parked": None,
                "lane": None,
                "run": None,
                "deadline": None,
                "status": None,
                "sha": None,
                "reason": None,
                "overlap_runs": set(),  # conservative outcomes for older unlinked logs
            }
            st["order"].append(tid)
        return st["tasks"][tid]

    for _lineno, obj, err in read_events(path, False):
        if err is not None or not isinstance(obj, dict) or not isinstance(obj.get("ev"), str):
            st["bad"] += 1
            continue
        ev = obj["ev"]
        if _is_int(obj.get("seq")):
            st["last_seq"] = max(st["last_seq"], obj["seq"])
        if ev == "open":
            st["open"] = obj
        elif ev == "close":
            st["close"] = obj
        elif ev == "admit" and isinstance(obj.get("task"), str):
            t = task(obj["task"])
            t.update(state="admitted", dispatched=False, accepted=False, landed=False, parked=None,
                     tier=obj.get("tier"), surfaces=obj.get("surfaces", []))
        elif ev == "dispatch" and obj.get("agent") == GATE_AGENT:
            # A composed gate names its batch (`T2,T3`) as its task. It is a live lane until it
            # returns, never a task: its result reaches tasks through gate, accept and park.
            st["lanes"][obj.get("run")] = {
                "lane": obj.get("lane"),
                "task": obj.get("task"),
                "agent": GATE_AGENT,
                "deadline": obj.get("deadline"),
            }
        elif ev == "dispatch" and isinstance(obj.get("recovery_of"), str):
            # Block generation is a separate live lifecycle, not implementation work.
            st["lanes"][obj.get("run")] = {
                "lane": obj.get("lane"), "task": obj.get("task"),
                "agent": obj.get("agent"), "deadline": obj.get("deadline"),
                "recovery_of": obj["recovery_of"],
            }
        elif ev == "dispatch" and isinstance(obj.get("task"), str):
            t = task(obj["task"])
            overlapping = any(i.get("task") == obj["task"] and not i.get("recovery_of")
                              for i in st["lanes"].values())
            t["overlap_runs"] = (t["overlap_runs"] if overlapping else set()) | {obj.get("run")}
            lane, run = obj.get("lane"), obj.get("run")
            t.update(
                state="dispatched",
                dispatched=True,
                parked=None,
                lane=lane,
                run=run,
                deadline=obj.get("deadline"),
                status=None,
            )
            st["lanes"][run] = {
                "lane": lane,
                "task": obj["task"],
                "agent": obj.get("agent"),
                "deadline": obj.get("deadline"),
            }
            st["lane_task"][lane] = obj["task"]
        elif ev == "return":
            audit = st["audit_lanes"].get(obj.get("run"))
            if audit is not None:
                audit["coderabbit"] = isinstance(obj.get("coderabbit"), dict) and obj["coderabbit"].get("ran") is True
            run, lane = obj.get("run"), obj.get("lane")
            info = st["lanes"].pop(run, None)
            if info and info.get("agent") == GATE_AGENT:
                continue
            dispatch = st["dispatches"].get(run) or info or {}
            tid = dispatch.get("task") or st["lane_task"].get(lane)
            replay = run in st["returns"]
            st["returns"].setdefault(run, obj)
            if tid in st["tasks"]:
                t = st["tasks"][tid]
                # Irreversible evidence belongs to the run's original task, even
                # on a stale/replayed return. Never close a successor's lifecycle.
                if obj.get("landed") is True:
                    t["landed"] = True
                    t["sha"] = obj.get("sha")
                    if t["state"] == "returned":
                        t["state"] = "landed"
                if dispatch.get("recovery_of") or replay:
                    continue
                # A prior run's return is history, not the latest work outcome.
                if t["run"] is not None and t["run"] != run:
                    continue
                t["status"] = obj.get("status")
                if not t["landed"] or obj.get("landed") is True:
                    t["sha"] = obj.get("sha")
                t["state"] = "landed" if t["landed"] else "returned"
                t["dispatched"] = obj.get("status") == "complete"
                if obj.get("landed") is True:
                    t["landed"] = True
                    t["state"] = "landed"
        elif ev == "accept" and isinstance(obj.get("task"), str):
            t = task(obj["task"])
            if obj.get("accepted") is True:
                t.update(accepted=True, state="accepted", reason=obj.get("reason"))
            else:
                t.update(accepted=False, dispatched=False, state="rejected", reason=obj.get("reason"))
        elif ev == "park" and isinstance(obj.get("task"), str):
            t = task(obj["task"])
            t.update(parked=obj.get("needs"), state="parked", reason=obj.get("reason"))
        elif ev == "land" and isinstance(obj.get("task"), str):
            t = task(obj["task"])
            t.update(landed=True, state="landed", sha=obj.get("sha"))
        elif ev == "revert":
            tid = obj.get("task")
            if not isinstance(tid, str):
                tid = next(
                    (i for i, t in st["tasks"].items() if t["landed"] and t["sha"] == obj.get("sha")),
                    None,
                )
            if tid in st["tasks"]:
                st["tasks"][tid].update(
                    landed=False,
                    accepted=False,
                    dispatched=False,
                    state="reverted",
                    reason=obj.get("reason"),
                )
        elif ev == "gate":
            st["last_gate"] = obj
        elif ev == "heartbeat" and isinstance(obj.get("at"), str):
            st["has_activity"] = True
            st["heartbeat"] = obj["at"]
        elif ev == "watch" and isinstance(obj.get("what"), str):
            st["has_activity"] = True
            key = (obj["what"], obj.get("deadline"))
            if obj.get("op") == "start":
                st["watches"][key] = obj
            elif obj.get("op") == "stop":
                st["watches"].pop(key, None)
        elif ev == "judgement" and isinstance(obj.get("text"), str):
            st["judgements"].append(obj)
        if ev == "dispatch":
            st["dispatches"][obj.get("run")] = obj
            constituents = obj.get("tasks")
            if not isinstance(constituents, list) or not constituents:
                constituents = [obj.get("task")]
            tiers = [st["tasks"].get(tid, {}).get("tier") if isinstance(tid, str) else None
                     for tid in constituents]
            tier = obj.get("tier")
            if tier not in TIER:
                tier = ("guarded" if "guarded" in tiers else "routine") if all(t in TIER for t in tiers) else "unknown"
            st["audit_lanes"][obj.get("run")] = {
                "lane": obj.get("lane"), "run": obj.get("run"), "tasks": constituents,
                "tier": tier, "surface": obj.get("surface"), "kind": obj.get("kind"), "coderabbit": False,
            }
    # Legacy logs lack explicit recovery linkage. A first unfinished outcome
    # from overlapping work must not disappear behind another run's success.
    # Apply only after folding so neither delivery order nor replay can falsely
    # drain the task, and never replace the displayed state of a live successor.
    for t in st["tasks"].values():
        if t["state"] != "returned" or t["status"] != "complete":
            continue
        for run in sorted(t["overlap_runs"], key=str):
            outcome = st["returns"].get(run)
            if outcome and outcome.get("status") in ("partial", "blocked", "failed"):
                t.update(status=outcome["status"], dispatched=False,
                         lane=outcome.get("lane"), run=run)
                if not t["landed"]:
                    t["sha"] = outcome.get("sha")
                break
    return st


def tier_audit(st):
    counts = {tier: {"lanes": 0, "reviews": 0, "coderabbit": 0} for tier in (*TIER, "unknown")}
    for lane in st["audit_lanes"].values():
        group = counts[lane["tier"]]
        group["lanes"] += 1
        group["reviews"] += lane["kind"] == "review"
        group["coderabbit"] += lane["coderabbit"]
    return counts


def classify(st):
    live = set(i["task"] for i in st["lanes"].values())
    parked, admissible, open_tasks = [], [], []
    for tid in st["order"]:
        t = st["tasks"][tid]
        if t["parked"]:
            parked.append(tid)
            continue
        if t["landed"] or t["accepted"]:
            continue
        open_tasks.append(tid)
        if not t["dispatched"] and tid not in live:
            admissible.append(tid)
    return {
        "live_lanes": len(st["lanes"]),
        "open_tasks": len(open_tasks),
        "admissible": admissible,
        "parked": parked,
        "by_tier": tier_audit(st),
        "audit_lanes": list(st["audit_lanes"].values()),
    }


def _clip(text, limit):
    text = " ".join(text.split())
    return text if len(text) <= limit else text[: max(limit - 3, 0)] + "..."


def _short(sha):
    return sha[:12] if isinstance(sha, str) else str(sha)


def _landed_unfinished(t):
    """A landed claim from a return that was not complete: the commit may be on main, never gated."""
    return t["state"] == "landed" and t["status"] not in (None, "complete")


def _task_line(t, level):
    if level >= 1:
        label = t["state"]
        if t["parked"]:
            label = "parked:%s" % t["parked"]
        elif t["status"] and t["state"] == "returned":
            label = "returned:%s" % t["status"]
        elif _landed_unfinished(t):
            label = "landed:%s" % t["status"]
        return "- %s %s" % (t["id"], label)
    state = "landed:%s" % t["status"] if _landed_unfinished(t) else t["state"]
    parts = ["- %s: %s" % (t["id"], state)]
    if t["state"] == "dispatched":
        parts.append("lane=%s run=%s" % (t["lane"], t["run"]))
        if t["deadline"]:
            parts.append("deadline=%s" % t["deadline"])
    elif t["state"] == "returned":
        parts.append("status=%s lane=%s run=%s" % (t["status"], t["lane"], t["run"]))
    elif t["state"] == "parked":
        parts.append("needs=%s" % t["parked"])
        if t["reason"]:
            parts.append("(%s)" % _clip(t["reason"], 80))
    elif t["state"] == "landed" and t["sha"]:
        parts.append("sha=%s" % _short(t["sha"]))
    elif t["state"] in ("accepted", "rejected", "reverted") and t["reason"]:
        parts.append("(%s)" % _clip(t["reason"], 80))
    return " ".join(parts)


def render_digest(st, judgements, task_level):
    summary = classify(st)
    out = ["# Loop state"]
    op = st["open"]
    if op:
        out.append(
            "goal %s, tier %s, root %s (%s)"
            % (op.get("goal_sha256"), op.get("tier"), op.get("root"), op.get("root_model"))
        )
    else:
        out.append("goal unknown (no open event)")
    status = "seq %d" % st["last_seq"]
    if st["close"]:
        status += ", closed: %s" % st["close"].get("reason")
    if st["bad"]:
        status += ", %d unreadable lines" % st["bad"]
    out.append(status)
    if st["last_gate"]:
        g = st["last_gate"]
        exit_text = "null" if g.get("exit") is None else g.get("exit")
        out.append("last gate: %s %s exit %s" % (g.get("scope"), _short(g.get("sha")), exit_text))
    if st["has_activity"]:
        if st["heartbeat"]:
            out.append("last heartbeat: %s" % st["heartbeat"])
        out.append("")
        out.append("## Root watches (%d)" % len(st["watches"]))
        for watch in st["watches"].values():
            out.append("- %s deadline %s" % (_clip(watch["what"], 160), watch.get("deadline")))
    out.append("")
    out.append("## Tier audit")
    for tier, counts in summary["by_tier"].items():
        out.append("- %s: lanes %d reviews %d coderabbit %d" % (tier, counts["lanes"], counts["reviews"], counts["coderabbit"]))
    out.append("")
    out.append("## Live lanes (%d)" % summary["live_lanes"])
    for run, info in st["lanes"].items():
        line = "- %s task %s run %s" % (info["lane"], info["task"], run)
        if info["deadline"]:
            line += " deadline %s" % info["deadline"]
        out.append(line)
    out.append("")
    out.append("## Admissible (%d)" % len(summary["admissible"]))
    out.append(", ".join(summary["admissible"]) if summary["admissible"] else "none")
    out.append("")
    tasks = [st["tasks"][i] for i in st["order"]]
    if task_level >= 3:
        out.append("## Tasks (%d, detail omitted)" % len(tasks))
    else:
        if task_level == 2:
            shown = [t for t in tasks if t["state"] not in ("landed", "accepted") or _landed_unfinished(t)]
            out.append("## Tasks (%d, %d done omitted)" % (len(tasks), len(tasks) - len(shown)))
        else:
            shown = tasks
            out.append("## Tasks (%d)" % len(tasks))
        for t in shown:
            out.append(_task_line(t, task_level))
    out.append("")
    out.append("## Judgements (last %d)" % len(judgements))
    for j in judgements:
        scope = " ".join("%s=%s" % (k, j[k]) for k in ("task", "lane") if j.get(k))
        out.append("- #%s%s %s" % (j.get("seq"), (" " + scope) if scope else "", _clip(j["text"], 400)))
    return "\n".join(out) + "\n"


def build_digest(st):
    """At most DIGEST_MAX_BYTES. Over the limit: drop the oldest judgements first, then reduce
    task detail, then cut."""
    judgements = st["judgements"][-JUDGEMENTS_IN_DIGEST:]
    text = ""
    for task_level in (0, 1, 2, 3):
        for drop in range(len(judgements) + 1):
            text = render_digest(st, judgements[drop:], task_level)
            if len(text.encode("utf-8")) <= DIGEST_MAX_BYTES:
                return text
        judgements = []
    marker = "\n[truncated]\n"
    cut = text.encode("utf-8")[: DIGEST_MAX_BYTES - len(marker)]
    return cut.decode("utf-8", "ignore") + marker


# ---------------------------------------------------------------------------- CLI


def _pop_by(args):
    by, rest, i = None, [], 0
    while i < len(args):
        a = args[i]
        if a == "--by":
            if i + 1 >= len(args):
                raise Rejected("--by needs a value")
            by = args[i + 1]
            i += 2
        elif a.startswith("--by="):
            by = a[len("--by=") :]
            i += 1
        else:
            rest.append(a)
            i += 1
    return by, rest


def _pop_run_dir(args):
    run_dir, rest, i = None, [], 0
    while i < len(args):
        a = args[i]
        if a == "--run-dir":
            if i + 1 >= len(args):
                raise Rejected("--run-dir needs a value")
            run_dir = args[i + 1]
            i += 2
        elif a.startswith("--run-dir="):
            run_dir = a[len("--run-dir=") :]
            i += 1
        else:
            rest.append(a)
            i += 1
    return run_dir, rest


def cmd_append(args):
    by, rest = _pop_by(args)
    run_dir, rest = _pop_run_dir(rest)
    env_dir = os.environ.get("LOOP_PI_RUN_DIR") or None
    if env_dir and os.path.isfile(os.path.join(env_dir, "loop-pi-proto")):
        # The environment's marked run dir is authoritative: an agent-supplied --run-dir must not
        # point the budget-close check at a dir without the marker or the facts.
        if run_dir and os.path.realpath(run_dir) != os.path.realpath(env_dir):
            sys.stderr.write("loop-state: warning: ignoring --run-dir %s; LOOP_PI_RUN_DIR %s holds "
                             "loop-pi-proto and is used instead\n" % (run_dir, env_dir))
        run_dir = env_dir
    else:
        run_dir = run_dir or env_dir
    if not rest:
        raise Rejected("usage: loop-state append <log> [<ev> k=v ...] [--by ...]")
    log_path, rest = rest[0], rest[1:]
    if rest:
        event = parse_kv(rest[0], rest[1:])
    else:
        try:
            event = json.loads(sys.stdin.read())
        except ValueError as exc:
            raise Rejected("stdin is not valid JSON (%s)" % exc)
        if not isinstance(event, dict):
            raise Rejected("event must be a JSON object")
        for key in ("v", "seq", "ts"):
            if key in event:
                raise Rejected("%s is set by loop-state" % key)
    framed = do_append(log_path, event, by, run_dir)
    for warning in telemetry_warnings(framed):
        sys.stderr.write("loop-state: warning: %s\n" % warning)
    sys.stdout.write("seq=%d\n" % framed["seq"])
    return 0


def telemetry_warnings(event):
    """Warn mode for the tier and surface telemetry: the event is already appended, but a missing
    admit `tier` or ops dispatch `surface` leaves the audit split unknown, so name the field."""
    out = []
    if event["ev"] == "admit" and "tier" not in event:
        out.append("admit %s has no tier; pass tier=routine|guarded so its lanes and reviews "
                   "are audited by tier" % event["task"])
    if event["ev"] == "dispatch" and event["agent"] in OPS_AGENTS and "surface" not in event:
        out.append("dispatch %s (%s) has no surface; pass the bound ops surface as surface=<id>"
                   % (event["run"], event["agent"]))
    return out


def cmd_digest(args):
    as_json = "--json" in args
    rest = [a for a in args if a != "--json"]
    if len(rest) != 1:
        sys.stderr.write("usage: loop-state digest <log> [--json]\n")
        return 2
    try:
        st = fold(rest[0])
    except OSError as exc:
        sys.stderr.write("loop-state: cannot read %s: %s\n" % (rest[0], exc.strerror))
        return 1
    if as_json:
        sys.stdout.write(json.dumps(classify(st), separators=(",", ":")) + "\n")
    else:
        sys.stdout.write(build_digest(st))
    return 0


def cmd_check(args):
    if len(args) != 1:
        sys.stderr.write("usage: loop-state check <log>\n")
        return 2
    try:
        err = do_check(args[0])
    except OSError as exc:
        sys.stderr.write("loop-state: cannot read %s: %s\n" % (args[0], exc.strerror))
        return 1
    if err:
        sys.stderr.write("loop-state: %s\n" % err)
        return 1
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        sys.stdout.write(__doc__)
        return 0 if argv else 2
    cmd, args = argv[0], argv[1:]
    try:
        if cmd == "append":
            return cmd_append(args)
        if cmd == "digest":
            return cmd_digest(args)
        if cmd == "check":
            return cmd_check(args)
    except Rejected as exc:
        sys.stderr.write("loop-state: %s\n" % exc)
        return 2
    except OSError as exc:
        sys.stderr.write("loop-state: %s\n" % exc)
        return 1
    sys.stderr.write("loop-state: unknown command %r\n" % cmd)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
