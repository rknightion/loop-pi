#!/bin/sh
# Installed by `just setup` from hooks/pre-commit; `just check` fails if it is missing or edited.
# Never bypass it with --no-verify and never point core.hooksPath elsewhere in this repository.
set -eu
top=$(git rev-parse --show-toplevel)
# Prefer Python 3.15 (PATH, Homebrew, then an installed one uv knows of; uv never downloads here).
# The scan is stdlib-only and is a gate, so with no 3.15 anywhere it runs on python3 instead of
# refusing the commit or push.
py=
for candidate in python3.15 /opt/homebrew/bin/python3.15 /home/linuxbrew/.linuxbrew/bin/python3.15; do
  if command -v "$candidate" >/dev/null 2>&1; then py=$candidate; break; fi
done
if [ -z "$py" ] && command -v uv >/dev/null 2>&1; then py=$(uv python find --no-python-downloads 3.15 2>/dev/null || true); fi
exec "${py:-python3}" "$top/bin/leak-scan" --staged
